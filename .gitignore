# ===========================================================================
#  CONFIDENTIAL DATA — never commit any of this
#
#  This repository holds the CODE for the litigation system.
#  It must never hold client data, case records, or database exports.
#  Anything matching the patterns below stays on the local machine only.
# ===========================================================================

# NOTE ON THE ODD-LOOKING PATTERNS BELOW
#
# [aA][cC][cC][dD][bB] is just "accdb", spelled so that case does not matter.
#
# This is not decoration. Windows treats FILE.XLSM and file.xlsm as the same
# name, so a lowercase-only rule LOOKS like it works here. The Ubuntu server
# does not, and there .XLSM, .ZIP and .SQLITE were all committable.
# .gitignore has no "ignore case" switch, so each letter is spelled both ways.
#
# scripts/check-gitignore.ts runs with case sensitivity forced on, so this
# cannot silently rot back.

# Microsoft Access databases
*.[aA][cC][cC][dD][bB]
*.[mM][dD][bB]
*.[aA][cC][cC][dD][eE]
*.[mM][dD][eE]
*.[lL][aA][cC][cC][dD][bB]
*.[lL][dD][bB]

# Database dumps and backups
*.[sS][qQ][lL].[gG][zZ]
*.[dD][uU][mM][pP]
*.[bB][aA][kK]
*.backup
dump/
backups/

# Extracted data from the migration
_export/
_export2/
_migration/
analysis/
analysis_direct/
analysis_source/
staging/
attachments/

# Spreadsheets and CSVs.
#
# The firm has decided this data is not confidential, so the reason for this
# rule is now OPERATIONAL, and it is just as binding: git keeps every version
# of every file for ever. The Access database is 46 MB compacted. Commit it
# once and the repository carries it permanently — deleting it later does not
# shrink the history, and every future clone pays for it.
*.[cC][sS][vV]
*.[tT][sS][vV]
*.[xX][lL][sS][xX]
*.[xX][lL][sS][mM]
*.[xX][lL][sS][bB]
*.[xX][lL][sS]
*.[oO][dD][sS]
!docs/**/*.[xX][lL][sS][xX]   # except blank templates deliberately kept in docs

# Other databases. Anything holding rows belongs outside the repository.
*.[sS][qQ][lL][iI][tT][eE]
*.[sS][qQ][lL][iI][tT][eE]3
*.[dD][bB]

# Archives. Usually an export of something large that is already excluded
# above, smuggled past these rules by being compressed.
*.[zZ][iI][pP]
*.7[zZ]
*.[rR][aA][rR]
*.[tT][aA][rR]
*.[gG][zZ]
*.[tT][gG][zZ]

# Extracted client logos and documents
uploads/
storage/
media/

# Printed reports and scanned paperwork. Every sample the firm has supplied
# carries real client names, case numbers and figures. Blanket rule: no PDF
# in this repository. If a genuinely blank template is ever needed, add an
# exception for it here deliberately.
*.[pP][dD][fF]

# Report samples supplied by the firm — real client data, kept locally only.
docs/report-samples/


# ===========================================================================
#  SECRETS
# ===========================================================================
.env
.env.*
!.env.example
*.[pP][eE][mM]
*.[kK][eE][yY]
*.[pP]12
credentials.json
secrets.json


# ===========================================================================
#  BUILD OUTPUT AND DEPENDENCIES
# ===========================================================================
node_modules/
/.pnp
.pnp.*
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
.turbo/

# Generated by Next.js on every build — not source, do not commit.
next-env.d.ts

# Vercel CLI
.vercel

# Prisma generated client. Rebuilt by `npm install` (postinstall) and by
# `npm run db:generate`, so it is never committed.
prisma/generated/
src/generated/

# Playwright
playwright-report/
test-results/
/playwright/.cache/


# ===========================================================================
#  EDITOR AND OPERATING SYSTEM
# ===========================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store


# ===========================================================================
#  LOGS
# ===========================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/


# ===========================================================================
#  DOCKER
# ===========================================================================
docker-compose.override.yml
postgres-data/
pgdata/