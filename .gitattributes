# ===========================================================================
#  LINE ENDINGS
#
#  Development happens on Windows; the server is Ubuntu. Without a rule here,
#  the same file looks "completely changed" depending on which machine touched
#  it last, and Prettier and git undo each other's work forever.
#
#  Rule: everything is LF, in the repository AND in the working copy.
#  This overrides a local core.autocrlf setting.
# ===========================================================================
* text=auto eol=lf

# Windows-native scripts must keep CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary files — git must never rewrite a byte of these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.accdb binary
*.mdb   binary

# This applied migration's checksum includes its terminal separator line.
# Preserve those immutable bytes while retaining every other whitespace check.
prisma/migrations/20260902120000_finalize_task33a_enforcement/migration.sql whitespace=-blank-at-eof
