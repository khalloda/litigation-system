{
  "name": "litigation-system",
  "version": "0.1.0",
  "private": true,
  "description": "Litigation management system for Sarie Eldin & Partners",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:rtl && npm run check:gitignore && npm run check:encoding",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U litigation -d litigation",
    "db:verify": "docker compose exec db psql -U litigation -d litigation -f /verify.sql",
    "db:reset": "tsx scripts/db-reset.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:check": "tsx scripts/check-db.ts",
    "load:staging": "tsx scripts/load-staging.ts",
    "profile:staging": "tsx scripts/profile-staging.ts",
    "review:workbook": "tsx scripts/build-review-workbook.ts",
    "review:import": "tsx scripts/import-review-answers.ts",
    "review:attach-legacy-identity": "tsx scripts/attach-legacy-workbook-identity.ts",
    "transform:clients": "tsx scripts/transform-clients.ts",
    "transform:matters": "tsx scripts/transform-matters.ts",
    "transform:matter-relationships": "tsx scripts/transform-matter-relationships.ts",
    "transform:hearings": "tsx scripts/transform-hearings.ts",
    "transform:admin-works": "tsx scripts/transform-admin-works.ts",
    "transform:powers-of-attorney": "tsx scripts/transform-powers-of-attorney.ts",
    "transform:documents": "tsx scripts/transform-documents.ts",
    "transform:fee-letters": "tsx scripts/transform-fee-letters.ts",
    "attendees:audit": "tsx scripts/apply-attendee-decomposition.ts",
    "check:rtl": "tsx scripts/check-rtl.ts && tsx scripts/check-rtl.ts --self-test",
    "check:gitignore": "tsx scripts/check-gitignore.ts",
    "check:encoding": "tsx scripts/check-encoding.ts",
    "test:guard": "tsx scripts/test-db-reset-guard.ts",
    "test:gate1": "pwsh -NoProfile -File scripts/test-gate1.ps1",
    "test:staging-copy": "tsx scripts/test-staging-copy.ts",
    "test:review-import": "tsx scripts/test-review-import.ts",
    "test:attendee-decomposition": "tsx scripts/test-attendee-decomposition.ts",
    "test:attendee-audit": "tsx scripts/test-attendee-audit.ts",
    "test:matter-transform": "tsx scripts/test-matter-transform.ts",
    "test:matter-relationships": "tsx scripts/test-matter-relationships.ts",
    "test:hearing-transform": "tsx scripts/test-hearing-transform.ts",
    "test:admin-transform": "tsx scripts/test-admin-transform.ts",
    "test:poa-transform": "tsx scripts/test-poa-transform.ts",
    "test:document-transform": "tsx scripts/test-document-transform.ts",
    "test:fee-letter-transform": "tsx scripts/test-fee-letter-transform.ts",
    "generate:lookup-seed": "tsx scripts/generate-lookup-seed.ts",
    "generate:roster-seed": "tsx scripts/generate-roster-seed.ts",
    "baseline:write": "tsx scripts/write-baseline.ts",
    "generate:court-seed": "tsx scripts/generate-court-seed.ts",
    "generate:staging-schema": "tsx scripts/generate-staging-schema.ts",
    "generate:matter-crosswalk": "tsx scripts/generate-matter-crosswalk.ts",
    "generate:matter-relationship-rules": "tsx scripts/generate-matter-relationship-rules.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "exceljs": "^4.4.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
