/// A party's legal capacity. 11 roles (decision D7), replacing 242 distinct
/// capacity strings that were mostly grammatical inflections of these.
///
/// Masculine and feminine forms are stored so the right word can be rendered
/// from the role plus the party's gender. طاعن and متظلم are DIFFERENT roles
/// and must never be merged.
model LookupPartyRole {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  code      String  @unique
  labelArM  String  @map("label_ar_m")
  labelArF  String  @map("label_ar_f")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@map("lookup_party_role")
}

/// What happened at a hearing (الإجراء)? 23 values — **PROVISIONAL**.
///
/// The seeded values are NOT yet confirmed. The review sheet marked all 23
/// "already clean" without inspecting them, and that default was mistaken for
/// a decision.
///
/// At least three of the 23 are the same word: محكمة, محكمه (ه for ة) and
/// مجكمة (ج for ح, adjacent keys) are one court action typed three ways, not
/// three actions. This list is being re-analysed against the real Access data
/// and corrected values will follow.
///
/// **Do not build task 1.6 (Arabic search) on this list until it is
/// corrected** — see TASKS.md.
model LookupHearingAction {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@map("lookup_hearing_action")
}

