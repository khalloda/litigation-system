  createdByActor AuditActor @relation("MatterLawyerCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "matter_lawyers_created_by_fkey")
  updatedByActor AuditActor @relation("MatterLawyerUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "matter_lawyers_updated_by_fkey")

  @@unique([matterId, personId], map: "matter_lawyers_matter_person_key")
