  @@map("lookup_importance")
}

/// A party's legal capacity. 11 roles (decision D7), replacing 242 distinct
/// capacity strings that were mostly grammatical inflections of these.
///
/// Masculine and feminine forms are stored so the right word can be rendered
/// from the role plus the party's gender. طاعن and متظلم are DIFFERENT roles
/// and must never be merged.
model LookupPartyRole {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  code      String  @unique
  labelArM  String  @map("label_ar_m")
  labelArF  String  @map("label_ar_f")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  partyRoles MatterPartyRole[]

  @@map("lookup_party_role")
}

/// What happened at a hearing (الإجراء)? 20 values, sorted by how often each
/// appears in the live data.
///
/// Was 23. Three were keyboard slips of other values in the same list, merged
/// on 21 August 2026 after the firm re-analysed them:
///
///   محكمه       ه for ة                      -> محكمة
///   مجكمة       ج for ح, adjacent keys       -> محكمة
///   رفع الدعوي  ي for ى                      -> رفع الدعوى
///
/// Scale: محكمة is on 11,210 hearings, its two misspellings on 17 between
/// them. Typos, not distinctions.
///
/// تحكيم (arbitration) and تحقيق (investigation) are NOT merged. They look
/// similar to an algorithm and are different words.
///
/// Nothing is lost by merging: every hearing keeps its original text in
/// hearings.legacy_action_raw, so a merge can be reversed.
model LookupHearingAction {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  hearings Hearing[]

  @@map("lookup_hearing_action")
}

/// Which authority the matter sits with (الجهة)? 27 values.
///
/// Re-analysed 21 August 2026 with the other two unexamined lists. Nothing
/// needed changing.
model LookupMatterDestination {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  matters    Matter[]
  adminTasks AdminTask[]

  @@map("lookup_matter_destination")
}

/// Client branch or group. 15 values.
///
/// **A branch is A SITE OR SUBSIDIARY OF A CLIENT, and nothing else.**
/// Decision D19, settled by the firm on 21 August 2026 — see
/// sql/client-branch-resolution.sql.
///
/// Was 32, then 31, now 15. The column had been holding at least three
/// different concepts at once — the same overloaded-column pattern as
/// matterDegree (D8), affecting 560 matters:
///
///   * genuine branches and sites — تويوتا إيجيبت, فرع المنصورة, المنطقة الحرة
///   * practice areas duplicating matter_category — مدني, ضرائب, تعويضات
///   * a court instance — النقض
///   * three values that are separate CLIENTS, not branches
///   * two numbered headings pasted out of a document
///
/// The 16 that were not branches were removed and each one recorded in
/// migration_crosswalk, so Stage 2 still maps the old text. Every client
/// keeps its original branch text in clients.legacy_branch_raw (task 1.3).
///
/// المنطقة الحرة IS a branch — the third site of أدخنة النخلة. An earlier
/// note had it moving to lookup_venue; the firm corrected that, and venue
/// stays at 7.
model LookupClientBranch {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  clients Client[]

  @@map("lookup_client_branch")
}

// ---------------------------------------------------------------------------
//  Still to come in Stage 1:
//    1.2 people + aliases, and lookup_team (which references people)
//    1.3 core       1.4 junctions
//    1.5 billing and deferred          1.6 Arabic search
//
//  migration_crosswalk belongs to Stage 2 and is created there, with the
//  crosswalk rows, rather than sitting empty until then.
// ---------------------------------------------------------------------------

// ===========================================================================
//  MIGRATION CROSSWALK
//
//  Every distinct Access value and where it goes. This table IS the mapping
//  logic: it is data, not code, so a correction is an UPDATE and a re-run
//  rather than a code change.
//
//  Created here rather than in Stage 2, which is where it was originally
//  planned. The reason for deferring it was that it would sit empty until
//  then. It no longer would: the four lookup merges confirmed on 21 August
//  2026 are real mapping rules today, and a note saying "remember to add
//  these in Stage 2" is the kind of dependency on memory this project keeps
//  removing.
//
//  Not an application table, so it carries created_at only rather than the
//  full audit set — nobody edits it through the interface.
// ===========================================================================
model MigrationCrosswalk {
  id           Int     @id @default(autoincrement())
  /// Which Access column the value came from, e.g. hearing_action.
  sourceField  String  @map("source_field")
  /// The value exactly as typed in Access. Never altered.
  sourceValue  String  @map("source_value")
  /// How many rows in the live data carry this value.
  rowsAffected Int?    @map("rows_affected")
  /// Where it goes. Stage 2 reads this to decide what to do with the value:
  ///
  ///   a lookup name      map to that list — 'matter_category', 'degree',
  ///                      'matter_type', 'hearing_action', 'venue'.
  ///                      target_value MUST exist in it.
  ///   'quarantine'       no automatic mapping. Send the row to the review
  ///                      queue and let a human decide.
  ///   'separate_client'  the matter is attached to THE WRONG CLIENT.
  ///                      Quarantine at task 2.6 and never guess the right
  ///                      one — the firm decides.
  ///   NULL               the value is discarded and the row simply loses it.
  ///                      Only ever for a value the firm has said is not data.
  ///
  /// A marker ('quarantine', 'separate_client') carries no target_value; a
  /// list name must carry one. Both are asserted by the migration and by
  /// npm run db:check, including that target_field is a name this project
  /// recognises — a misspelled one would otherwise be skipped by the resolve
  /// checks and look perfectly healthy.
  targetField  String? @map("target_field")
  targetValue  String? @map("target_value")
  reviewerNote String? @map("reviewer_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceField, sourceValue])
  @@map("migration_crosswalk")
}

// ===========================================================================
//  PEOPLE — task 1.2
//
//  One roster for every human the system knows about, replacing Access's two
//  lawyer tables (D5). Names are NEVER used as keys: everything joins by id.
//
//  135 people, from 373 distinct spellings typed by hand into 18 columns over
//  six years. That collapse is the highest-ratio mapping in the project and
//  the one that has already gone wrong twice — a single missing hamza made
//  أحمد إسماعيل into two people, one carrying 1,309 hearings. Which is why
//  person_name_alias exists, and why every match goes through it.
// ===========================================================================

/// Every human the system knows about. 135 rows:
/// 64 firm staff (21 current, 43 former) + 71 external.
///
/// Was 140, then 138, then 135 — two hamza duplicates merged out at task 1.2,
/// three generator artefacts at 1.2b. Every figure here is asserted by
/// npm run db:check, which is the authority; if this comment and that check
/// ever disagree, the check is right.
model Person {
  id     Int     @id @default(autoincrement())
  nameAr String  @unique @map("name_ar")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  nameArNormalised String? @map("name_ar_normalised")
  nameEn String? @map("name_en")

  /// Login address. Nullable because only a handful of people ever log in;
  /// unique where present, which a UNIQUE constraint gives for free since
  /// PostgreSQL allows many NULLs. Needed by Milestone 4.
  email String? @unique

  /// false = external counsel, mostly named on powers of attorney. Real
  /// people who must be recorded, but never log in, are never assigned
  /// matters, and never appear in staff pick-lists.
  isStaff   Boolean @default(true) @map("is_staff")
  /// false = has left the firm. Kept so historical hearings and matters still
  /// show who did the work. Excluded from new-entry dropdowns.
  isActive  Boolean @default(true) @map("is_active")
  isTrainee Boolean @default(false) @map("is_trainee")
  /// Former staff never log in. Set per account at Milestone 4.
  canLogin  Boolean @default(false) @map("can_login")

  /// Which work team. NULL is valid and common — 16 of the 21 current staff
  /// have none. Team-grouped reports must show those under an "unassigned"
  /// heading, never drop them. Deliberately NOT on the matter (D6).
  teamId Int?        @map("team_id") @db.SmallInt
  team   LookupTeam? @relation("TeamMembers", fields: [teamId], references: [id])

  /// Teams this person reviews (المراجع).
  reviews LookupTeam[] @relation("TeamReviewer")

  aliases PersonNameAlias[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  /// Administrative tasks assigned to this person (المسئول).
  adminTasks AdminTask[]
  /// Paper documents this person is responsible for.
  documents  Document[]
  /// Administrative task steps this person carried out (القائم بالعمل).
  taskActions TaskAction[]
  /// Matters this person is a lawyer on.
  matterLawyers MatterLawyer[]
  /// Hearings this person attended.
  hearingAttendees HearingAttendee[]
  /// Shares of collections allocated to this person.
  invoiceAllocations InvoiceAllocation[]
  /// Leave register entries.
  attendance Attendance[]

  @@index([isStaff, isActive])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([nameArNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("people")
}

/// Every spelling ever typed, mapped to one person. 347 rows.
///
/// This is what makes the migration safe and historical search work: any raw
/// Access string is looked up here to find the right person, and searching
/// for a spelling nobody uses any more still finds them.
///
/// **Match through this table, never through people.name_ar** — rule 15.
model PersonNameAlias {
  id        Int     @id @default(autoincrement())
  personId  Int     @map("person_id")
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// The spelling exactly as it appeared. Unique across the whole roster: one
  /// spelling cannot belong to two people.
  aliasAr   String  @unique @map("alias_ar")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  aliasArNormalised String? @map("alias_ar_normalised")
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([personId])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([aliasArNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("person_name_alias")
}

/// Work teams. The label lives on the PERSON, never on the matter (D6): 87%
/// of matters were all on "team 1", so the field carried no information.
///
/// Two teams. Access "team 3" overlapped teams 1 and 2, was used by 3 matters
/// and had a different reviewer — an abandoned duplicate, deliberately not
/// created.
model LookupTeam {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  code        String?
  labelAr     String  @unique @map("label_ar")
  /// التخصصات, free text.
  specialisms String?
  /// المراجع — the partner who reviews this team's work.
  reviewerId  Int?    @map("reviewer_id")
  reviewer    Person? @relation("TeamReviewer", fields: [reviewerId], references: [id])
  sortOrder   Int     @default(100) @map("sort_order") @db.SmallInt
  isActive    Boolean @default(true) @map("is_active")

  members Person[] @relation("TeamMembers")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@map("lookup_team")
}

// ---------------------------------------------------------------------------
//  DEFERRED to Stage 2, task 2.7 — the multi-person split rules
//
//  migration_multi_person_rule (33), _member (66) and migration_excluded_name
//  (38) were going to be created here with the roster, on the same reasoning
//  as migration_crosswalk: they hold reviewed data now, so a note saying
//  "add them later" is a dependency on memory.
//
//  They are NOT created, because building the assertion found the data is not
//  ready. Four of the 66 member names resolve to nobody:
//
//    محمد عبدالعزيز عبد الحافظ   (2 rows)  the roster spells it
//                                          محمد عبد العزيز عبد الحافظ
//    عبدالرحمن البنا             (1 row)   the roster spells it
//                                          عبد الرحمن البنا
//    an entire eight-lawyer string pasted in as ONE member name (1 row) —
//    that rule was never split, so the matter using it would lose all eight
//
//  Each would silently drop a lawyer from a matter during Stage 2, which is
//  precisely what these rules exist to prevent. Loading them would mean
//  either weakening the assertion or seeding data known to be wrong.
//  Raised with the firm; they load at task 2.7 once corrected.
// ---------------------------------------------------------------------------

// ===========================================================================
//  COURTS — task 1.3
//
//  A tenth lookup list, added here rather than at 1.1 because nothing needed
//  it until matters and hearings arrived.
//
//  A LIST, not free text. The firm counted: 305 distinct court names across
//  13,205 hearings, repeating heavily — القاهرة الاقتصادية 1,982 times,
//  شبين الكوم 1,192, شمال القاهرة 1,134. Egypt has a finite number of courts,
//  and docs/PERMISSIONS.md already promises the Administrator manages the
//  court dropdown.
//
//  EMPTY UNTIL STAGE 2. The values come from the Access data, and about 300
//  of them will need the same spelling-variant cleanup as every other Arabic
//  list — القضاء الإداري and القضاء الإداري بالعباسية may be one court with a
//  location suffix. That is a task 2.5 job, and every table that references a
//  court keeps its original text in a legacy_court_raw column so the cleanup
//  stays reversible.
//
//  THE CIRCUIT (الدائرة) IS DELIBERATELY NOT A LIST — see the Matter model.
// ===========================================================================

/// Courts. Administrator-managed. Filled at Stage 2, ~305 values before the
/// spelling cleanup.
model LookupCourt {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  matters    Matter[]
  hearings   Hearing[]
  adminTasks AdminTask[]

  @@map("lookup_court")
}

// ===========================================================================
//  CORE TABLES — task 1.3
//
//  Nine tables from docs/DATA-MODEL.md, plus client_logos (a child of clients
//  that task 2.11 needs) and lookup_court above.
//
//  ALL EMPTY. Stage 2 fills them. They are built now, with correct keys, so
//  that adding the data later is a load and not a schema migration — the same
//  reasoning D3 gives for the billing tables.
//
//  TWO CONVENTIONS THAT APPLY TO EVERY TABLE BELOW
//
//  1. legacy_id — the Access primary key, kept for good.
//     Gate 4 has to reconcile row for row against Access, not merely count
//     (docs/MIGRATION.md), and a re-run of a transform has to be able to find
//     the row it wrote last time. Unique WHERE PRESENT: PostgreSQL allows many
//     NULLs in a unique column, so rows the firm creates in the new system
//     simply have none. The Access key names are ID_client, matterID,
//     ID_hearings, ID_Task and contractID — see scripts/01_extract_access.ps1.
//
//  2. _raw columns — the original text beside every many-to-one mapping.
//     D10 and the audit table in docs/MIGRATION.md. Four of the five that task
//     1.3 must create live here; the fifth, hearing_attendees.legacy_name_raw,
//     arrives with its table at task 1.4, and all five are asserted before
//     Stage 2 loads a row.
//     A COURT IS NOW ONE OF THEM: ~305 spellings collapsing to a cleaned list
//     is a many-to-one mapping, so every court_id has a legacy_court_raw
//     partner. Without it the Stage 2 cleanup would be irreversible.
//
//  NOTHING IS NOT-NULL THAT THE ACCESS DATA CANNOT GUARANTEE. A load must
//  never reject a row (docs/MIGRATION.md): 834 matters have no lawyer, 4
//  hearings have no matter, 1 power of attorney has no client, 14 matters will
//  lose their branch. Those all have to arrive and be dealt with visibly,
//  which a NOT NULL constraint would prevent.
// ===========================================================================

/// The firm and its clients. 313 rows at Stage 2.
model Client {
  id       Int  @id @default(autoincrement())
  /// Access ID_client. See the legacy_id convention above.
  legacyId Int? @unique @map("legacy_id")

  /// 100% filled in the Access data.
  nameAr   String  @map("name_ar")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  nameArNormalised String? @map("name_ar_normalised")
  /// 73% filled. Kept for a possible future bilingual version (D12).
  nameEn   String? @map("name_en")
  fullName String? @map("full_name")
  fullNameNormalised String? @map("full_name_normalised")

  branchId Int?                @map("branch_id") @db.SmallInt
  branch   LookupClientBranch? @relation(fields: [branchId], references: [id])
  /// The original clientBranch text, byte for byte. NOT OPTIONAL as a design
  /// choice: the 32 original values resolve to 15 (D19) — 9 move to
  /// matter_category, 1 to matter_type, 1 to degree, 4 are quarantined and 2
  /// are discarded. Without this column that resolution could never be
  /// reversed or re-derived.
  legacyBranchRaw String? @map("legacy_branch_raw")

  cashOrProbono     String?   @map("cash_or_probono")
  status            String?
  poaLocation       String?   @map("poa_location")
  documentsLocation String?   @map("documents_location")
  clientStart       DateTime? @map("client_start") @db.Date
  clientEnd         DateTime? @map("client_end") @db.Date

  /// The main person to contact. Nullable, and deliberately a plain optional
  /// relation rather than a required one: clients and contacts point at each
  /// other, so one side has to be able to arrive first.
  contactPersonId Int?     @map("contact_person_id")
  contactPerson   Contact? @relation("ClientPrimaryContact", fields: [contactPersonId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  contacts   Contact[]         @relation("ClientContacts")
  logo       ClientLogo?
  matters    Matter[]
  poas       PowerOfAttorney[]
  feeLetters FeeLetter[]

  @@index([nameAr])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([nameArNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("clients")
}

/// Where a client logo file lives. 54 rows at Stage 2.
///
/// D15: the image is a FILE ON THE SERVER, never in the database and never in
/// cloud storage — /var/lib/litigation/client-logos/{client_id}/{filename}
///
/// One logo per client, so client_id is unique. A missing file must print the
/// client name in text and never break a report (D15).
model ClientLogo {
  id       Int    @id @default(autoincrement())
  clientId Int    @unique @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Relative to the logo root, never an absolute path — the root differs
  /// between the laptop and the Ubuntu server.
  relativePath String  @map("relative_path")
  fileName     String  @map("file_name")
  contentType  String  @map("content_type")
  byteSize     Int     @map("byte_size")
  /// Checksum of the file as extracted from Access. Task 2.11 verifies it
  /// before and after writing, Gate 4 compares all 54, and it is what lets
  /// the weekly integrity job required by D15 report a CHANGED file rather
  /// than only a missing one.
  sha256       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@map("client_logos")
}

/// People to contact at a client. 188 rows at Stage 2.
///
/// Complete: all 17 Access columns are accounted for. The percentage on each
/// column is HOW MUCH OF IT IS ACTUALLY FILLED in the live data, supplied by
/// the firm. It is recorded because a fill rate is a design fact: Home Phone
/// has ONE row in 188, and a screen or report built around it would be blank
/// almost always.
///
/// **Contact1 is the real name field at 97%; Full_name is 10%.** Do not
/// assume from the names which one is primary — the firm checked.
///
/// Contacts.Attachments looks 100% populated and holds ZERO files. It is an
/// Access complex column (D11) and is NOT migrated.
model Contact {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Nullable: a contact whose client cannot be resolved loads with a null
  /// link and is queued for review, never dropped.
  clientId Int?    @map("client_id")
  client   Client? @relation("ClientContacts", fields: [clientId], references: [id])

  /// Access `Contact1`, 97% filled. THE name field, despite the column name.
  contactName String? @map("contact_name")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  contactNameNormalised String? @map("contact_name_normalised")
  /// Access `Full_name`, 10% filled. Not the primary name — see above.
  fullName    String? @map("full_name")
  /// Access `Job Title`, 60%.
  jobTitle    String? @map("job_title")

  /// Access `E-mail Address`, 75%.
  email         String? @map("email")
  /// Access `Mobile Phone`, 73%.
  mobilePhone   String? @map("mobile_phone")
  /// Access `Business Phone`, 47%.
  businessPhone String? @map("business_phone")
  /// Access `Home Phone`, **1% — one row in 188.** Migrated, never surfaced.
  homePhone     String? @map("home_phone")
  /// Access `Fax Number`, 25%.
  faxNumber     String? @map("fax_number")
  /// Access `Web Page`, 14%.
  webPage       String? @map("web_page")

  /// Access `Address`, 67%.
  address       String? @map("address")
  /// Access `City`, 68%.
  city          String? @map("city")
  /// Access `State/Province`, 65%.
  stateProvince String? @map("state_province")
  /// Access `ZIP/Postal Code`, 6%.
  zipPostalCode String? @map("zip_postal_code")
  /// Access `Country/Region`, 65%.
  countryRegion String? @map("country_region")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  /// The clients for whom this person is the main contact.
  primaryFor Client[] @relation("ClientPrimaryContact")

  @@index([clientId])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([contactNameNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("contacts")
}

/// Matters — the central table. 1,730 rows at Stage 2.
///
/// In Access this was 47 columns mixing identity, court logistics, money,
/// classification and free text. Only what the Dashboard actually reaches is
/// built (D1), and the classification is split into four independent lists
/// (D8) instead of the two overloaded ones Access had.
model Matter {
  id       Int  @id @default(autoincrement())
  /// Access matterID.
  legacyId Int? @unique @map("legacy_id")

  /// **MULTI-LINE. NEVER SPLIT, NEVER COLLAPSED TO ONE LINE — D9.**
  /// 308 matters (18%) hold several case numbers stacked with line breaks:
  /// the journey of the matter up through the courts. The firm decided not to
  /// parse them; every screen and every report must render all the lines.
  caseNumberAr String? @map("case_number_ar")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  caseNumberArNormalised String? @map("case_number_ar_normalised")
  /// 98% filled.
  subject      String?
  subjectNormalised String? @map("subject_normalised")

  clientId Int?    @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  // ---- classification: four independent lists, D8 ------------------------
  matterTypeId     Int?                     @map("matter_type_id") @db.SmallInt
  matterType       LookupMatterType?        @relation(fields: [matterTypeId], references: [id])
  matterCategoryId Int?                     @map("matter_category_id") @db.SmallInt
  matterCategory   LookupMatterCategory?    @relation(fields: [matterCategoryId], references: [id])
  degreeId         Int?                     @map("degree_id") @db.SmallInt
  degree           LookupDegree?            @relation(fields: [degreeId], references: [id])
  venueId          Int?                     @map("venue_id") @db.SmallInt
  venue            LookupVenue?             @relation(fields: [venueId], references: [id])
  importanceId     Int?                     @map("importance_id") @db.SmallInt
  importance       LookupImportance?        @relation(fields: [importanceId], references: [id])
  destinationId    Int?                     @map("destination_id") @db.SmallInt
  destination      LookupMatterDestination? @relation(fields: [destinationId], references: [id])

  /// The original matterCategory and matterDegree text, byte for byte. 50 and
  /// 40 values collapse into the four lists above; without these the split
  /// could not be re-derived or corrected (D10).
  legacyCategoryRaw String? @map("legacy_category_raw")
  legacyDegreeRaw   String? @map("legacy_degree_raw")

  /// سارية 493 / منتهية 1,223 / null 14.
  status String?

  // ---- where it is heard -------------------------------------------------
  /// court and circuit are TWO SEPARATE FIELDS, not one. Reports join them
  /// for display — الإدارية العليا (11 موضوع),
  /// المحكمة الاقتصادية (الدائرة: (9) استئناف) — but they are stored apart.
  /// Source: docs/REPORT-LAYOUTS.md, "Type 4 — Client status report".
  courtId        Int?         @map("court_id") @db.SmallInt
  court          LookupCourt? @relation(fields: [courtId], references: [id])
  legacyCourtRaw String?      @map("legacy_court_raw")

  /// **TEXT, DELIBERATELY NOT A LIST.** 1,281 distinct values in the hearings
  /// table alone. They are two facts in one field — a circuit number and a
  /// specialism (1 عمال, 12 عمال, 8 تجاري, 7 استئناف, 4 أفراد) — varying by
  /// court. A 1,281-option dropdown is unusable and a list would fight the
  /// data. Whether to split it into number + specialism is a question for
  /// AFTER the data lands: see task 2.6. Do not attempt the split now.
  circuit String?

  // ---- court logistics ---------------------------------------------------
  /// Kept on the matter rather than in a matter_court_details table. Four
  /// columns on one row per matter; a separate table buys nothing until
  /// something needs many of them per matter, and it would add a join to
  /// every matter screen. Settled 22 August 2026 — the open question in
  /// docs/DATA-MODEL.md is closed.
  courtFloor         String? @map("court_floor")
  courtHall          String? @map("court_hall")
  courtShelf         String? @map("court_shelf")
  courtSecretaryRoom String? @map("court_secretary_room")

  /// الدعاوى.[خطاب الأتعاب] — a reference to the mfiles_id of a fee letter,
  /// NOT a foreign key. 412 matters carry a value and 289 of them match no
  /// fee letter. This is a DIFFERENT relationship from fee_letter_matters
  /// (288 values across 195 parents, task 1.4) and the two numbers must not
  /// be reconciled against each other. Kept as text so the unmatched ones can
  /// be quarantined with their original value intact.
  feeLetterRef String? @map("fee_letter_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  hearings   Hearing[]
  adminTasks AdminTask[]
  documents  Document[]
  lawyers    MatterLawyer[]
  parties    MatterParty[]
  feeLetters FeeLetterMatter[]

  @@index([clientId])
  @@index([status])
  @@index([courtId])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([caseNumberArNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([subjectNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("matters")
}

/// Hearings and their decisions. 13,279 rows at Stage 2 — the largest table.
///
/// Every list screen and report over this table needs paging and indexed
/// filters (task 4.3). The indexes at the foot are the ones the traced screens
/// and reports actually use: by matter, by date, and the "today's hearings"
/// panel on the dashboard, which reads the next date.
model Hearing {
  id       Int  @id @default(autoincrement())
  /// Access ID_hearings.
  legacyId Int? @unique @map("legacy_id")

  /// Nullable: 4 hearings in the Access data have no matter. They load into an
  /// unassigned bucket rather than being rejected (docs/MIGRATION.md).
  matterId Int?    @map("matter_id")
  matter   Matter? @relation(fields: [matterId], references: [id])

  hearingDate     DateTime? @map("hearing_date") @db.Date
  nextHearingDate DateTime? @map("next_hearing_date") @db.Date

  actionId Int?                 @map("action_id") @db.SmallInt
  action   LookupHearingAction? @relation(fields: [actionId], references: [id])
  /// The original الإجراء text. 23 actions merged to 20 on 21 August 2026
  /// (محكمه and مجكمة into محكمة, رفع الدعوي into رفع الدعوى), which affects
  /// 18 hearings and makes the mapping many-to-one. Without this the merge
  /// could never be reversed.
  legacyActionRaw String? @map("legacy_action_raw")

  decision String?
  /// صالح / ضد. Drives the for-and-against reports and the dashboard charts.
  outcome  String?

  courtId        Int?         @map("court_id") @db.SmallInt
  court          LookupCourt? @relation(fields: [courtId], references: [id])
  legacyCourtRaw String?      @map("legacy_court_raw")
  /// Text, for the same reason as Matter.circuit.
  circuit        String?

  clientNotified Boolean? @map("client_notified")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  attendees HearingAttendee[]

  @@index([matterId])
  @@index([hearingDate])
  @@index([nextHearingDate])
  @@index([courtId])
  @@map("hearings")
}

/// Administrative works. 4,207 rows at Stage 2.
///
/// **The only area Paralegals can edit** (docs/PERMISSIONS.md).
model AdminTask {
  id       Int  @id @default(autoincrement())
  /// Access ID_Task.
  legacyId Int? @unique @map("legacy_id")

  matterId Int?    @map("matter_id")
  matter   Matter? @relation(fields: [matterId], references: [id])

  requiredWork String? @map("required_work")

  /// The person responsible. Resolved through person_name_alias at Stage 2,
  /// never by matching people.name_ar — rule 15.
  assignedToPersonId Int?    @map("assigned_to_person_id")
  assignedTo         Person? @relation(fields: [assignedToPersonId], references: [id])
  /// The typed name exactly as it appeared. One of the three person-name
  /// mappings that had NO raw column until the 21 August audit — and names are
  /// the highest-ratio mapping in this project, the one that has already gone
  /// wrong twice. person_name_alias records that a spelling exists; only this
  /// records which spelling THIS row used.
  legacyAssigneeRaw String? @map("legacy_assignee_raw")

  executionDate    DateTime? @map("execution_date") @db.Date
  result           String?
  previousDecision String?   @map("previous_decision")
  lastFollowup     DateTime? @map("last_followup") @db.Date
  deadline         DateTime? @db.Date

  courtId        Int?         @map("court_id") @db.SmallInt
  court          LookupCourt? @relation(fields: [courtId], references: [id])
  legacyCourtRaw String?      @map("legacy_court_raw")
  circuit        String?

  destinationId Int?                     @map("destination_id") @db.SmallInt
  destination   LookupMatterDestination? @relation(fields: [destinationId], references: [id])

  status String?
  alert  String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  actions TaskAction[]

  @@index([matterId])
  @@index([assignedToPersonId])
  @@index([executionDate])
  @@index([status])
  @@map("admin_tasks")
}

/// Steps within an administrative task. 4,130 rows at Stage 2.
///
/// Complete: all 7 Access columns are accounted for.
///
/// task_id is nullable on purpose and the numbers are known in advance: 36
/// rows have an ID_Task matching no task and 39 have none at all. All 75 load
/// with a null link and go to the review queue. **Do not discard them.**
model TaskAction {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  taskId Int?       @map("task_id")
  task   AdminTask? @relation(fields: [taskId], references: [id])
  /// The original ID_Task, kept even when it resolves to nothing — that is
  /// what makes the 36 orphans investigable rather than merely lost.
  /// Access `ID_Task`, 99%.
  legacyTaskIdRaw String? @map("legacy_task_id_raw")

  /// Access `تاريخ الإجراء`, 97%.
  actionDate DateTime? @map("action_date") @db.Date

  /// Access `القائم بالعمل`, 96% — the person who did the work.
  ///
  /// **A FOURTH PERSON-NAME MAPPING, and it needs its raw partner for the
  /// same reason as the other three.** Resolved through person_name_alias at
  /// Stage 2, never by matching people.name_ar — rule 15. The alias table
  /// records that a spelling exists; only legacy_performed_by_raw records
  /// which spelling THIS row used.
  performedByPersonId  Int?    @map("performed_by_person_id")
  performedBy          Person? @relation(fields: [performedByPersonId], references: [id])
  legacyPerformedByRaw String? @map("legacy_performed_by_raw")

  /// Access `النتيجة`, 99%.
  result String? @map("result")
  /// Access `تقرير`, 100%.
  report String? @map("report")
  /// Access `الموعد القادم`, **0% — seven rows in 4,130.** Migrated because
  /// nothing is deleted (D10), but effectively dead. Do not surface it.
  nextAppointment DateTime? @map("next_appointment") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([taskId])
  @@index([performedByPersonId])
  @@map("task_actions")
}

/// Powers of attorney. 735 rows at Stage 2.
///
/// Complete: all 15 Access columns are accounted for.
///
/// **`الصفة` AND `صفة الموكل بالتوكيل` ARE THE SAME FIELD, DUPLICATED.**
/// The firm compared them row by row across all 735: 565 identical, 164
/// filled in `الصفة` only, **zero filled in the other only**, 4 different —
/// and three of those four are typos of each other. One column a strict
/// superset and the other never uniquely populated is the signature of a copy
/// that stopped being maintained.
///
/// `الصفة` is the live one and the application reads it. Both are migrated
/// (D10) and the duplicate is never read.
///
/// **THIS IS NOT THE D7 PARTY CAPACITY, and the names keep them apart.**
/// D7 covers a party's procedural ROLE in a matter — plaintiff, appellant —
/// from a closed list of 11, and lives on matter_party_roles. This is the
/// capacity in which a person GRANTED a power of attorney: `شخصي`
/// (personally) or a corporate office. Free text, 306 distinct values, no
/// list and no lookup table. Do not conflate them.
model PowerOfAttorney {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Nullable: 1 power of attorney in the Access data has no client.
  clientId Int?    @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  /// Access `العميل`, 84% — the client name as typed. `clientID` at 100% is
  /// the authoritative link; this is kept as written.
  clientName String? @map("client_name")

  /// Access `المحامون الصادر لهم التوكيل`, 100% — up to twelve lawyers in one
  /// string, and where the 71 external people in the roster came from.
  ///
  /// It stays TEXT here. The split into rows happens at task 2.9 and needs
  /// the same treatment as the hearing attendees. This holds the field
  /// exactly as typed — the third of the three person-name mappings that had
  /// no raw column until the 21 August audit.
  legacyLawyersRaw String? @map("legacy_lawyers_raw")

  /// Access `مسلسل`, 82% — the sequence column on the powers-of-attorney
  /// report.
  ///
  /// **TEXT, NOT A NUMBER.** Despite the name, the values are Latin letters —
  /// A, B, C. Typing it as an integer would fail the load on every row.
  serialNo String? @map("serial_no")
  /// Access `اسم الموكل`, 100% — the name of the principal granting the power.
  principalName String? @map("principal_name")
  /// Access `الصفة`, 100% — **the live capacity field.** The capacity in
  /// which the principal granted the power: `شخصي`, or a corporate office
  /// such as `عضو منتدب لشركة أكيومن`. Free text, 306 distinct values.
  poaCapacity String? @map("poa_capacity")
  /// Access `صفة الموكل بالتوكيل`, 77% — **the abandoned duplicate of
  /// poa_capacity.** Migrated because nothing is deleted (D10). **Never read
  /// it**; every value it holds is either identical to poa_capacity, absent,
  /// or stale.
  poaCapacityDuplicate String? @map("poa_capacity_duplicate")

  /// Access `رقم التوكيل`, 99% — the number part of the POA reference.
  poaNumber String? @map("poa_number")
  /// Access `حرف`, 99% — the LETTER-SERIES part of the POA reference. 28
  /// values, nearly all single Arabic letters: `أ` on 183, `ب` on 167.
  /// The powers-of-attorney report prints the three parts together:
  /// **982 / أ / 2009** is number / letter / year.
  poaLetter String? @map("poa_letter")
  /// Access `السنة`, 99% — the year part of the same reference.
  poaYear String? @map("poa_year")

  /// Access `جهة الإصدار`, 100% — the authority that issued it.
  issuingAuthority String? @map("issuing_authority")
  /// Access `تاريخ الإصدار`, 100%.
  issueDate DateTime? @map("issue_date") @db.Date

  /// Access `عدد النسخ`, 99% — **a LIVE COUNT of copies currently in the
  /// safe.** Not a static figure and not a yes/no flag.
  ///
  /// A lawyer takes a copy out to attend court and the count drops; it rises
  /// when the copy comes back. That is why the powers-of-attorney report
  /// highlights ZERO in yellow — "none available" — and why `ملاحظات` on
  /// those rows reads `عهدة إيهاب حمدي`. **Those rows are documents signed
  /// out, not errors.**
  ///
  /// Distribution across the 735 rows: 0 on 113, 1 on 577, 2 on 29, 3 on 7,
  /// 4 on 2, 8 on one row, and 6 blank. So 39 rows (5%) hold more than one
  /// copy — normal practice, usually because the original was deposited at
  /// the Cassation court and certified copies were extracted
  /// (`تم إيداعة بالنقض وتم استخراج نسختين طبق الأصل`).
  ///
  /// **Plain integer, nullable, NO UPPER BOUND.** Never a boolean, and never
  /// a CHECK capping it at 1.
  /// **ZERO IS A VALID, MEANINGFUL STATE** — no copy available — and must
  /// never be treated as missing data or as an error.
  /// **The six blanks are genuinely unknown and stay NULL**, which is a
  /// different thing from zero.
  copiesCount Int? @map("copies_count")

  /// Access `ملاحظات`, 53%.
  notes String? @map("notes")
  /// Access `جرد`, 100% — a yes/no flag: 1 on 680 rows, 0 on 55.
  ///
  /// **PROBABLE, NOT CONFIRMED.** The firm's reading is "does it pass the
  /// periodical inventory check", which fits 680 passing and 55 failing —
  /// but they said "I think". Recorded as probable in docs/GLOSSARY.md.
  /// **Nothing may depend on it until it is confirmed.**
  inventory Boolean? @map("inventory")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([clientId])
  @@map("powers_of_attorney")
}

/// The paper document register. 405 rows at Stage 2.
///
/// This records DESCRIPTIONS of paper documents and where the hard copy is
/// filed. **The system does not store files** (docs/PRD.md).
model Document {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  matterId Int?    @map("matter_id")
  matter   Matter? @relation(fields: [matterId], references: [id])

  description String?
  pageCount   Int?      @map("page_count")
  depositDate DateTime? @map("deposit_date") @db.Date

  /// Who is responsible for the paper. Resolved through person_name_alias.
  responsiblePersonId  Int?    @map("responsible_person_id")
  responsiblePerson    Person? @relation(fields: [responsiblePersonId], references: [id])
  legacyResponsibleRaw String? @map("legacy_responsible_raw")

  movementCard    String? @map("movement_card")
  storageLocation String? @map("storage_location")

  /// Optional reference into M-Files, the existing document system of the
  /// firm. Precedent: خطابات الأتعاب.mfilesID is filled on 306 of 331 rows.
  mfilesId String? @map("mfiles_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([matterId])
  @@index([responsiblePersonId])
  @@map("documents")
}

/// Fee letters and engagement contracts. 331 rows at Stage 2.
///
/// Still actively used in Access as of November 2025, while invoices stop in
/// December 2021 — four years of billing has run in Excel, detached from the
/// contracts it belongs to (D3).
///
/// **contract_id MUST SURVIVE MIGRATION UNCHANGED.** Phase 2 invoicing
/// attaches to these records, and the Excel the firm has kept in the meantime
/// refers to them by that number. It is the one legacy identifier in this
/// project that is not merely useful for reconciliation.
///
/// Complete: all 10 Access columns are accounted for. `Matter` is the
/// multi-value complex column — 288 values across 195 parents (D11) — and
/// becomes the fee_letter_matters table at task 1.4, not a column here.
model FeeLetter {
  id Int @id @default(autoincrement())

  /// Access contractID. Unique and preserved exactly — see above.
  contractId Int? @unique @map("contract_id")

  clientId Int?    @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  /// Access `mfilesID`, 92% — 306 of 331 rows.
  mfilesId String? @map("mfiles_id")

  /// Access `Client`, 65% — the client name as typed. `clientID` at 100% is
  /// the authoritative link.
  clientName String? @map("client_name")

  /// Access `Cont-Type`, 94%.
  contractType String? @map("contract_type")
  /// Access `Cont-Date`, 93%.
  contractDate DateTime? @map("contract_date") @db.Date
  /// Access `Cont-Details`, 98%.
  contractDetails String? @map("contract_details")
  /// Access `Cont-Structure`, 85%.
  contractStructure String? @map("contract_structure")

  /// Access `Status`, **1% — three rows in 331.** Migrated because nothing is
  /// deleted (D10). **Do not build a screen around it.**
  status String? @map("status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  matters  FeeLetterMatter[]
  invoices Invoice[]

  @@index([clientId])
  @@map("fee_letters")
}

// ===========================================================================
//  JUNCTION TABLES — task 1.4
//
//  The five tables that replace the places where Access put several facts in
//  one field. Every one of them exists because a text column was doing the
//  job of a relationship:
//
//    lawyerA / lawyerB and 38 combination strings  ->  matter_lawyers
//    client&Cap / opponent&Cap, 242 capacity strings -> matter_parties
//                                                     + matter_party_roles
//    الحاضر and حاضر 1-4, 373 spellings            ->  hearing_attendees
//    خطابات الأتعاب.Matter, a multi-value column    ->  fee_letter_matters
//
//  ALL EMPTY. Stage 2 fills them, at tasks 2.7 (lawyers and parties), 2.8
//  (attendees) and 2.9 (fee letters).
//
//  THE FIFTH RAW COLUMN IS HERE. hearing_attendees.legacy_name_raw completes
//  the five that task 1.3 required — 373 spellings collapse to 135 people,
//  the highest-ratio mapping in the project and the one that has already gone
//  wrong twice. All five are now present and asserted together.
// ===========================================================================

/// Which lawyers are on a matter, and in what capacity.
///
/// Replaces Access `lawyerA` / `lawyerB` and the 38 rows of `المحامين`, which
/// were mostly COMBINATIONS of lawyers — a workaround for Access not
/// supporting many-to-many (D5). **Names are never keys.**
///
/// Expected at Stage 2: 896 matters with a lead, 241 with support, 834 with
/// no lawyer recorded at all. 896 + 834 = 1,730.
///
/// **A null lawyer is normal.** 834 of 1,730 matters have none, which is why
/// D14 refuses to restrict billing to "the lawyer's own matters" — such a
/// rule would hide half the firm from everybody.
model MatterLawyer {
  id       Int    @id @default(autoincrement())
  matterId Int    @map("matter_id")
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  personId Int    @map("person_id")
  person   Person @relation(fields: [personId], references: [id])

  /// lead | co_lead | support. A CHECK constraint, not a lookup table and not
  /// a PostgreSQL enum.
  ///
  /// Not a lookup table because nobody adds a lawyer role without a code
  /// change — reports branch on `lead` — which is the exact opposite of the
  /// case D8 makes for courts and categories being tables.
  /// Not an enum because D8 rules those out project-wide.
  role String

  /// Order within the role, so "lawyerA then lawyerB" survives.
  position Int?

  /// The exact source string this row came from — including the combination
  /// strings that split into several rows. Without it a split could never be
  /// re-derived or corrected.
  legacySource String? @map("legacy_source")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([matterId])
  @@index([personId])
  @@map("matter_lawyers")
}

/// The parties to a matter, on either side.
///
/// Replaces `client&Cap` and `opponent&Cap`, which held the party name AND
/// their legal capacity in one field — 92% and 83% of them multi-line.
model MatterParty {
  id       Int    @id @default(autoincrement())
  matterId Int    @map("matter_id")
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  /// client | opponent. A CHECK constraint — see MatterLawyer.role.
  side String

  partyName String? @map("party_name")

  /// m | f, or null when it is not known or the party is an organisation.
  /// Used to render the right form of the role: D7 stores مدعي and مدعية and
  /// picks between them, rather than storing 242 inflected capacity strings.
  gender String?

  /// Position within the side, so the first-named party stays first.
  ordinal Int?

  /// The `client&Cap` or `opponent&Cap` field exactly as typed, name and
  /// capacity together. 242 distinct capacity strings collapse to 11 roles;
  /// this is what makes that reversible.
  legacyRaw String? @map("legacy_raw")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  roles MatterPartyRole[]

  @@index([matterId])
  @@map("matter_parties")
}

/// A party can hold more than one role. D7: `مستأنف ضده، مستأنف` becomes TWO
/// ROWS, not one combined value.
model MatterPartyRole {
  id      Int         @id @default(autoincrement())
  partyId Int         @map("party_id")
  party   MatterParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  roleId Int             @map("role_id") @db.SmallInt
  role   LookupPartyRole @relation(fields: [roleId], references: [id])

  /// Order the roles were written in.
  ordinal Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([partyId])
  @@map("matter_party_roles")
}

/// Who attended a hearing.
///
/// Replaces `الحاضر` and `حاضر 1`–`حاضر 4`: free text, **373 distinct
/// spellings for 135 people**, plus multi-person strings with no consistent
/// separator.
///
/// **`**` MEANS NO ATTENDANCE RECORDED AND BECOMES NO ROWS, NOT A PERSON.**
/// It appears 4,143 times. The same for `لا يوجد حضور` and `متابعة`. A person
/// called `**` would then appear in dropdowns and reports for ever.
model HearingAttendee {
  id        Int     @id @default(autoincrement())
  hearingId Int     @map("hearing_id")
  hearing   Hearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)

  /// Nullable: a spelling that resolves to nobody loads with a null person
  /// and goes to the review queue — roughly 474 names appear only once and
  /// need a human. It is never dropped, and never invented as a new person.
  personId Int?    @map("person_id")
  person   Person? @relation(fields: [personId], references: [id])

  /// **THE FIFTH RAW COLUMN, and the one that matters most.**
  ///
  /// 373 spellings collapse to 135 people — the highest-ratio mapping in this
  /// project, and the one that has already gone wrong twice: a single missing
  /// hamza made أحمد إسماعيل into two people, one carrying 1,309 hearings.
  ///
  /// person_name_alias records that a spelling EXISTS. Only this records
  /// which spelling THIS hearing used. Without it, a merge later judged wrong
  /// could never be split back apart.
  legacyNameRaw String? @map("legacy_name_raw")

  /// Which of الحاضر, حاضر 1 … حاضر 4 this came from, and the order within a
  /// multi-person string.
  ordinal Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([hearingId])
  @@index([personId])
  @@map("hearing_attendees")
}

/// Which matters a fee letter covers.
///
/// From the Access multi-value column `خطابات الأتعاب.Matter` — **288 values
/// across 195 parents** (D11). A normal CSV export of that column gives
/// integers that look like data and are internal pointers.
///
/// **The values are case-number STRINGS (`1039 / 20ق`), not ids**, so
/// matching them to matters will leave rows unmatched — 289 of them are
/// already expected. Those load with a null matter_id and are quarantined.
/// **Do not drop them.**
///
/// **This is NOT the same relationship as `matters.fee_letter_ref`**, which
/// runs the other way — 412 matters carry a value and 289 match no fee
/// letter. Two different links and two different numbers that happen to share
/// a digit. Do not try to reconcile 288 against 289.
model FeeLetterMatter {
  id          Int       @id @default(autoincrement())
  feeLetterId Int       @map("fee_letter_id")
  feeLetter   FeeLetter @relation(fields: [feeLetterId], references: [id], onDelete: Cascade)

  /// Nullable: the case-number string may match no matter.
  matterId Int?    @map("matter_id")
  matter   Matter? @relation(fields: [matterId], references: [id])

  /// The case-number string exactly as it appeared in the multi-value column.
  /// This is the only record of what an unmatched row was pointing at.
  legacyMatterRef String? @map("legacy_matter_ref")

  /// Order within the parent fee letter.
  ordinal Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([feeLetterId])
  @@index([matterId])
  @@map("fee_letter_matters")
}

// ===========================================================================
//  BILLING LOOKUPS — task 1.5a
//
//  Three closed sets, counted in the Access file by the firm. **The only
//  lookups in this system whose values are LATIN**, and they stay exactly as
//  they are: the value is what Stage 2 matches on, and translating it would
//  mean the crosswalk had to match a translation.
//
//  So each has a `code` — the exact Access value — and a NULLABLE `label_ar`
//  for the Arabic word shown on screen. **The Arabic labels are not supplied
//  and are NOT invented here.** They are financial terms; rule 5 says ask.
//  They are needed before task 4.8, not before Stage 2.
//
//  Seed and counts: sql/billing-lookups.sql.
// ===========================================================================

/// Access `Inv-Status`. 5 values: Paid 460, Unpaid 60, Partially Paid 12,
/// Later 10, Canceled 1 — which is all 543 invoices.
model LookupInvoiceStatus {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  /// The exact Access value. Never translated.
  code      String  @unique
  /// The Arabic word to show. NOT YET SUPPLIED — see the block above.
  labelAr   String? @map("label_ar")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  invoices Invoice[]

  @@map("lookup_invoice_status")
}

/// Access `Inv-Type`. 2 values: Service 379, Expenses 162.
model LookupInvoiceType {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  code      String  @unique
  labelAr   String? @map("label_ar")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  invoices Invoice[]

  @@map("lookup_invoice_type")
}

/// Access `تقسيم التحصيلات.LawyerAs` — what role a lawyer held for the
/// purpose of splitting a collection. 4 values: Reviewer 16, LawyerA 16,
/// LawyerB 8, LawyerA+ 7, which is all 47 rows.
///
/// **`LawyerA+` is a CO-LEAD** — a second lead lawyer sharing the lead's
/// allocation, always a different person from `LawyerA`. Confirmed from the
/// data: every invoice carrying one splits Reviewer 0.250 / LawyerA 0.375 /
/// LawyerA+ 0.375, against Reviewer 0.250 / LawyerA 0.750 where there is
/// none. It maps to `matter_lawyers.role` = `co_lead` (D5).
model LookupLawyerShareRole {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  code      String  @unique
  labelAr   String? @map("label_ar")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  allocations InvoiceAllocation[]

  @@map("lookup_lawyer_share_role")
}

// ===========================================================================
//  BILLING AND DEFERRED TABLES — task 1.5
//
//  Four tables that exist in Phase 1 with correct keys and NO SCREENS (D3).
//  The firm runs all four in Excel today. Building them now means adding the
//  screens later is a feature, not a database migration.
//
//  INVOICES AND PAYMENTS ARE READ-ONLY FOR EVERY ROLE, INCLUDING THE
//  ADMINISTRATOR (D4, docs/PERMISSIONS.md). 543 invoices (2010–Dec 2021) and
//  597 payments (2013–Dec 2021) migrate so that old billing questions can be
//  answered; nobody can create or edit one in Phase 1. That is enforced on
//  the server in Stage 3, not by hiding a button.
//
//  BILLING IS VISIBLE TO ALL FOUR ROLES, for all clients (D14). Not
//  restricted to a lawyer's own matters: 834 of 1,730 matters have no lawyer
//  recorded, so such a rule would hide billing from everybody.
//
//  **THE COLUMN LISTS BELOW ARE INCOMPLETE AND KNOWN TO BE.** Only the keys
//  and the columns the documents actually name are modelled. The Access
//  column lists for الفواتير, السداد, Attendance and تقسيم التحصيلات have
//  never been written down, and nothing is invented — the same position task
//  1.3 took, and for the same reason. They are completed before Stage 2 loads
//  a row. Staging holds every source column as text, so nothing is at risk in
//  the meantime.
// ===========================================================================

/// Invoices. 543 rows at Stage 2, 2010 to December 2021. **Read-only.**
///
/// **DO NOT MIGRATE `الفواتير.Pay-Date` (D4).** It stopped in September 2019
/// and holds 126 stale values that the payments table supersedes. Migrating
/// it would put two disagreeing answers to "when was this paid" in front of a
/// partner.
model Invoice {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Access `Inv-No`, 100%. The number the firm and the client both refer to.
  invoiceNo String? @map("invoice_no")

  /// Access `contractID`, 100% — **THE LINK D3 REQUIRES.** An invoice attaches
  /// to a FEE LETTER, not directly to a client; the client comes through it.
  /// There is no clientID on الفواتير, and the placeholder client_id this
  /// table briefly carried has been removed.
  feeLetterId Int?       @map("fee_letter_id")
  feeLetter   FeeLetter? @relation(fields: [feeLetterId], references: [id])
  /// The contractID exactly as it appeared, kept even when it resolves to
  /// nothing — that is what makes an unmatched invoice investigable.
  legacyContractId String? @map("legacy_contract_id")

  /// Access `Currency`, 100%. Gate 4 reconciles **total invoiced and total
  /// paid, per currency** (docs/MIGRATION.md), so it has to survive. A total
  /// across mixed currencies is a meaningless number.
  currency String?
  /// Access `Amount`, 100%. Money is NEVER a floating-point number.
  amount   Decimal? @db.Decimal(14, 2)
  /// Access `USD$`, 4% — a dollar equivalent on a handful of rows. Kept
  /// because nothing is deleted; it is not a substitute for `amount`.
  amountUsd Decimal? @map("amount_usd") @db.Decimal(14, 2)

  /// Access `Inv-Date`, 100%.
  invoiceDate DateTime? @map("invoice_date") @db.Date

  /// Access `Inv-Status`, 100%.
  statusId Int?                 @map("status_id") @db.SmallInt
  status   LookupInvoiceStatus? @relation(fields: [statusId], references: [id])
  legacyStatusRaw String?       @map("legacy_status_raw")

  /// Access `Inv-Type`, 100%.
  typeId Int?               @map("type_id") @db.SmallInt
  type   LookupInvoiceType? @relation(fields: [typeId], references: [id])
  legacyTypeRaw String?     @map("legacy_type_raw")

  /// Access `Inv-Details`, 100%.
  details String?

  /// Access `VAT?`, 100% — **a yes/no flag, confirmed.** Only `1` (289 rows)
  /// and `0` (254). The `1` rows are `Service` invoices with ordinary
  /// amounts; nothing anywhere encodes a rate or a value. It means "VAT
  /// applies to this invoice", nothing more.
  vat Boolean?

  /// Access `report`, 100% — **a flag on eight invoices.** 535 zeros and 8
  /// ones. What it means is unknown and it is effectively unused. Migrated
  /// because nothing is deleted (D10); **do not surface it.**
  report Boolean?

  /// Access `R-#` and `R-$`. **A receipt amount and its currency — and my
  /// first reading of these was INVERTED.** The names suggest a number and an
  /// amount; the content says otherwise, and the firm counted it:
  ///
  ///   `R-#`  278 blank, 244 zero, and 21 rows holding round figures —
  ///          5000, 10000, 44000. Amounts, not receipt numbers.
  ///   `R-$`  520 blank, 21 rows holding `EGP`, 2 holding `0`. The 21 line up
  ///          exactly with the 21 populated `R-#` rows.
  ///
  /// So **21 invoices of 543 — under 4% — carry anything at all.** Migrated
  /// per D10 and **not surfaced**.
  ///
  /// **The `R-` naming suggests "receipt". That is an INFERENCE, not a
  /// fact** — the content only shows an amount and a currency travelling
  /// together.
  receiptAmount   Decimal? @map("receipt_amount") @db.Decimal(14, 2)
  receiptCurrency String?  @map("receipt_currency")

  /// Access `Pay-Date` is **NOT MIGRATED** (D4) — 23% filled, but it stops in
  /// September 2019 while payments run to December 2021. Migrating it would
  /// put two disagreeing answers to "when was this paid" in front of a
  /// partner. Its absence is asserted.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  payments    Payment[]
  allocations InvoiceAllocation[]

  @@index([feeLetterId])
  @@index([invoiceDate])
  @@index([statusId])
  @@map("invoices")
}

/// Payments against invoices. 597 rows at Stage 2, 2013 to December 2021.
/// **Read-only.**
model Payment {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Nullable: a payment whose invoice cannot be resolved loads with a null
  /// link and goes to the review queue, never dropped.
  invoiceId Int?     @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  /// Access `رقم الفاتورة`, 100% — the invoice number as written. The FK
  /// above is resolved from it; this keeps the original for the ones that
  /// resolve to nothing.
  legacyInvoiceNo String? @map("legacy_invoice_no")

  /// Access `العملة`, 91%.
  currency String?
  /// Access `Credit` 99% and `Debit` 52%. Two columns, not one `amount` —
  /// the placeholder this table briefly carried has been removed.
  credit Decimal? @db.Decimal(14, 2)
  debit  Decimal? @db.Decimal(14, 2)

  /// Access `التاريخ`, **67% — a third of payments have no date.** Nullable,
  /// and expected to show up at Gate 3 rather than being a surprise.
  paymentDate DateTime? @map("payment_date") @db.Date

  /// Access `بيان السداد`, 52%.
  details String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

/// How a collection is split between lawyers. Empty at Stage 2.
///
/// Replaces `تقسيم التحصيلات` (47 rows) and `LawyerShare4Invoices` (empty).
///
/// **The shares on one invoice must sum to 1.** That is a rule ACROSS rows,
/// which no CHECK constraint can express, so it lives in npm run db:check —
/// where it is vacuously true today and becomes meaningful the moment Phase 2
/// writes the first split. Rule 16: the strongest tool the rule allows.
///
/// A single share is constrained here to lie between 0 and 1, which a CHECK
/// constraint CAN express and which catches a percentage typed as 50.
model InvoiceAllocation {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Access `InvNo`, 100%. **Nullable**, like every other resolved link: a
  /// number that matches no invoice is quarantined, not rejected.
  invoiceId       Int?     @map("invoice_id")
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  legacyInvoiceNo String?  @map("legacy_invoice_no")

  /// Access `Lawyer`, 100% — **AND IT HOLDS ENGLISH NAMES.** `Ahmed
  /// Abdullah`, `Nagy Ramadan`, `Mohamed Abd El-Aziz`. Nine distinct people.
  ///
  /// **This is the only person column in the whole database that is Latin.**
  /// It resolves through `people.name_en`, NOT through person_name_alias —
  /// which holds Arabic spellings and would match nothing. Where `name_en` is
  /// null the row **quarantines**; it is never guessed.
  ///
  /// Nullable for exactly that reason. The `Int` it briefly was would have
  /// rejected every unresolvable row.
  personId Int?    @map("person_id")
  person   Person? @relation(fields: [personId], references: [id])
  /// The English name exactly as typed.
  legacyLawyerRaw String? @map("legacy_lawyer_raw")

  /// Access `LawyerAs`, 100%. Four values, and they line up exactly with the
  /// `matter_lawyers.role` set — see docs/GLOSSARY.md:
  ///
  ///   `Reviewer`  the partner who reviews (its own role, no matter_lawyers
  ///               equivalent)
  ///   `LawyerA`   -> lead
  ///   `LawyerA+`  -> co_lead — **a SECOND LEAD sharing the lead's share**,
  ///               always a different person from `LawyerA`. Not a variant of
  ///               LawyerA.
  ///   `LawyerB`   -> support
  ///
  /// The reviewer takes 25% and the remaining 75% goes either wholly to
  /// `LawyerA` or evenly between `LawyerA` and `LawyerA+`.
  ///
  /// **Do not build a rule that assumes 0.375.** Invoice 21819 has
  /// `LawyerA+` at 0.075. All 15 invoices with splits still sum to 1, so it
  /// is deliberate rather than an error — nothing to quarantine.
  lawyerRoleId Int?                   @map("lawyer_role_id") @db.SmallInt
  lawyerRole   LookupLawyerShareRole? @relation(fields: [lawyerRoleId], references: [id])
  legacyLawyerAsRaw String?           @map("legacy_lawyer_as_raw")

  /// A FRACTION, not a percentage: 0.25, never 25. Decimal(6,5) so thirds
  /// round predictably and three shares still add to 1.
  ///
  /// Access `Percent` (100%) holds a PERCENTAGE. Stage 2 divides by 100 and
  /// keeps the original in legacy_percent_raw, so the conversion is visible
  /// and reversible.
  share Decimal? @db.Decimal(6, 5)
  legacyPercentRaw String? @map("legacy_percent_raw")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([invoiceId])
  @@index([personId])
  @@map("invoice_allocations")
}

/// The staff leave register. 4,022 rows at Stage 2.
///
/// **THIS IS NOT MEETING ATTENDANCE.** D2 drops meetings and their attendance
/// entirely — three tables, 3,230 rows, archived and never migrated. This is
/// a different feature: who was on leave, and when. Deferred, not dropped
/// (D3), and the screens arrive in Phase 2.
model Attendance {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Resolved through person_name_alias at Stage 2, never by matching
  /// people.name_ar — rule 15. Nullable so a name that resolves to nobody
  /// goes to the review queue rather than being dropped.
  personId Int?    @map("person_id")
  person   Person? @relation(fields: [personId], references: [id])
  /// The typed name exactly as it appeared — a fifth person-name mapping, and
  /// it gets a raw partner for the same reason as the other four.
  legacyPersonRaw String? @map("legacy_person_raw")

  /// Access `AttDate`, 100%.
  attendanceDate DateTime? @map("attendance_date") @db.Date

  /// Access `AttSituation`, 100%. **FREE TEXT, NOT A STATUS LIST.**
  ///
  /// 865 distinct values: `At the Office` 749, `Nothing` 498,
  /// `At the office` 327 — the same value in different case — `Annual
  /// Vacation` 132, then hundreds of one-offs like
  /// `Admin work at Cairo economical court`. It is a daily log somebody typed
  /// into, not a set of states.
  ///
  /// **Do not make it a lookup.** It needs its own review before any dropdown
  /// is designed — recorded on the Phase 2 attendance task.
  situation String?
  /// The original text byte for byte, so a Phase 2 cleanup that folds `At the
  /// Office` and `At the office` together stays reversible.
  legacySituationRaw String? @map("legacy_situation_raw")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@index([personId])
  @@index([attendanceDate])
  @@map("attendance")
}
