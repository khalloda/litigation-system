/// Who attended a hearing.
///
/// Replaces `الحاضر` and `حاضر 1`–`حاضر 4`: 12,732 non-empty source cells,
/// 708 byte-distinct complete values and multi-person strings. Correction B
/// proved 9,113 person occurrences; task 2.8 creates 8,884 target rows across
/// 39 people and retains the other 229 under quarantined parents.
///
/// **`**` MEANS NO ATTENDANCE RECORDED AND BECOMES NO ROWS, NOT A PERSON.**
/// It is the complete value of 4,130 cells. The same principle applies to
/// `لا يوجد حضور` and `متابعة`. A person
/// called `**` would then appear in dropdowns and reports for ever.
model HearingAttendee {
  id        Int     @id @default(autoincrement())
  hearingId Int     @map("hearing_id")
  hearing   Hearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)

  /// Nullable for future application-native attendance that may temporarily
  /// await a person assignment. Unresolved legacy text never creates this row:
  /// it remains in the immutable Correction B audit/quarantine, with no legacy
  /// attendee inserted and no person invented.
  personId Int?    @map("person_id")
  person   Person? @relation(fields: [personId], references: [id])

  /// **THE FIFTH RAW COLUMN, and the one that matters most.**
  ///
  /// 373 spellings collapse to 135 people — the highest-ratio mapping in this
  /// project, and the one that has already gone wrong twice: a single missing
  /// hamza made أحمد إسماعيل into two people, one carrying 1,309 hearings.
  ///
  /// person_name_alias records that a spelling EXISTS. Only this records
  /// which spelling THIS hearing used. Without it, a merge later judged wrong
  /// could never be split back apart.
  legacyNameRaw String? @map("legacy_name_raw")

  /// Which of الحاضر, حاضر 1 … حاضر 4 this came from, and the order within a
  /// multi-person string.
  ordinal Int?

  /// Task 2.8 never reparses the source cell. These fields point back to the
  /// immutable Correction B cell/span that proved this person occurrence.
  legacySourceRecordKey        String? @map("legacy_source_record_key")
  legacySourceExtractionSha256 String? @map("legacy_source_extraction_sha256")
  sourceColumn                 String? @map("source_column")
  sourceColumnOrdinal          Int?    @map("source_column_ordinal") @db.SmallInt
  sourceCellId                 String? @map("source_cell_id")
  sourceSpanId                 String? @unique @map("source_span_id")
  sourceSpanSequence           Int?    @map("source_span_sequence")

  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor @relation("HearingAttendeeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "hearing_attendees_created_by_fkey")
  updatedByActor AuditActor @relation("HearingAttendeeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "hearing_attendees_updated_by_fkey")

  @@unique([hearingId, ordinal], map: "hearing_attendees_hearing_ordinal_key")
  @@index([hearingId])
  @@index([personId])
  @@index([createdBy], map: "hearing_attendees_created_by_idx")
  @@index([updatedBy], map: "hearing_attendees_updated_by_idx")
  @@map("hearing_attendees")
}

