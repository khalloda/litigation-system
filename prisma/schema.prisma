// ===========================================================================
//  Prisma schema — the shape of the database, in one file.
//
//  Nothing is edited directly in the database. A change is made here, then
//  `npm run db:migrate` writes a numbered migration file and applies it. The
//  migration files are committed, so the Ubuntu server can be brought to the
//  exact same state by replaying them in order.
//
//  Naming, per docs/DATA-MODEL.md: physical tables and columns are
//  snake_case ASCII. Arabic is a display label and lives in src/strings.ts,
//  never in a column name. Prisma models are PascalCase and map to the
//  snake_case table with @@map.
// ===========================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
//  LOOKUPS — task 1.1
//
//  Nine editable lists. TABLES, NEVER ENUMS (decision D8): an administrator
//  must be able to add a court or a practice area without a code change, and
//  a PostgreSQL enum cannot be changed without a migration.
//
//  Seed data comes from sql/lookups-and-crosswalk.sql and
//  sql/lookups-part2-and-teams.sql.
//
//  Six of the nine lists were reviewed value by value from the start. Three
//  — hearing_action, matter_destination and client_branch — had been marked
//  "already clean" without inspection, and that default was mistaken for a
//  decision. The firm re-analysed all three on 21 August 2026:
//
//    hearing_action       23 -> 20   three typos merged
//    client_branch        32 -> 31   جنح merged into الجنح
//    matter_destination   27         unchanged, nothing found
//    TOTAL               150 -> 146
//
//  See sql/lookup-corrections.sql and migration 0003. One question remains
//  open on client_branch — see its model below.
//
//  The seed is loaded by the migration, not by a seed script, because the
//  application cannot function without these lists — a fresh database must
//  arrive complete. Row counts are asserted in the migration itself.
//
//  Audit columns are on every table per docs/DATA-MODEL.md. created_by and
//  updated_by are plain integers for now and gain their foreign key to
//  `users` in Stage 3, when that table exists.
// ===========================================================================

/// What kind of work is this? 14 values. تقاضي is the default.
model LookupMatterType {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy Int?     @map("updated_by")

  @@map("lookup_matter_type")
}

