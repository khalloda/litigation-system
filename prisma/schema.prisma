/// The parties to a matter, on either side.
///
/// Replaces `client&Cap` and `opponent&Cap`, which held the party name AND
/// their legal capacity in one field — 92% and 83% of them multi-line.
model MatterParty {
  id       Int    @id @default(autoincrement())
  matterId Int    @map("matter_id")
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  /// client | opponent. A CHECK constraint — see MatterLawyer.role.
  side String

  partyName String? @map("party_name")

  /// m | f, or null when it is not known or the party is an organisation.
  /// Used to render the right form of the role: D7 stores مدعي and مدعية and
  /// picks between them, rather than storing 242 inflected capacity strings.
  gender String?

  /// Position within the side, so the first-named party stays first.
  ordinal Int?

  /// The `client&Cap` or `opponent&Cap` field exactly as typed, name and
  /// capacity together. 242 distinct capacity strings collapse to 11 roles;
  /// this is what makes that reversible.
  legacyRaw String? @map("legacy_raw")

  legacySourceRecordKey        String? @map("legacy_source_record_key")
  legacySourceExtractionSha256 String? @map("legacy_source_extraction_sha256")
  sourceField                  String? @map("source_field")
  sourceFragmentOrdinal        Int?    @map("source_fragment_ordinal")

  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor        @relation("MatterPartyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "matter_parties_created_by_fkey")
  updatedByActor AuditActor        @relation("MatterPartyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "matter_parties_updated_by_fkey")
  roles          MatterPartyRole[]

  @@unique([legacySourceRecordKey, sourceField, sourceFragmentOrdinal], map: "matter_parties_legacy_source_key")
  @@index([matterId])
  @@index([createdBy], map: "matter_parties_created_by_idx")
  @@index([updatedBy], map: "matter_parties_updated_by_idx")
  @@map("matter_parties")
}

/// A party can hold more than one role. D7: `مستأنف ضده، مستأنف` becomes TWO
