/// Powers of attorney. 752 rows in the current Stage 2 extraction.
///
/// Complete: all 15 Access columns are accounted for.
///
/// **`الصفة` AND `صفة الموكل بالتوكيل` ARE THE SAME FIELD, DUPLICATED.**
/// The firm compared them row by row across the original 735-row analysis:
/// 565 identical, 164
/// filled in `الصفة` only, **zero filled in the other only**, 4 different —
/// and three of those four are typos of each other. One column a strict
/// superset and the other never uniquely populated is the signature of a copy
/// that stopped being maintained.
///
/// `الصفة` is the live one and the application reads it. Both are migrated
/// (D10) and the duplicate is never read.
///
/// **THIS IS NOT THE D7 PARTY CAPACITY, and the names keep them apart.**
/// D7 covers a party's procedural ROLE in a matter — plaintiff, appellant —
/// from a closed list of 11, and lives on matter_party_roles. This is the
/// capacity in which a person GRANTED a power of attorney: `شخصي`
/// (personally) or a corporate office. Free text, 306 distinct values, no
/// list and no lookup table. Do not conflate them.
model PowerOfAttorney {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Nullable: 1 power of attorney in the Access data has no client.
  clientId Int?    @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  /// Access `العميل`, 84% — the client name as typed. `clientID` at 100% is
  /// the authoritative link; this is kept as written.
  clientName String? @map("client_name")

  /// Access `المحامون الصادر لهم التوكيل`, 100% — up to twelve lawyers in one
  /// string, and where the 71 external people in the roster came from.
  ///
  /// It stays TEXT here. Task 2.9B created reviewed lawyer rows while this
  /// field continues to hold the complete cell exactly as typed.
  legacyLawyersRaw String? @map("legacy_lawyers_raw")

  /// Durable Stage 2 source identity. All three fields are null together for
  /// records created in the new application and populated together for Access
  /// records. The payload preserves every original source column byte-for-byte.
  legacySourceRecordKey        String? @map("legacy_source_record_key")
  legacySourceExtractionSha256 String? @map("legacy_source_extraction_sha256")
  legacySourcePayload          Json?   @map("legacy_source_payload")

  /// Access `مسلسل`, 82% — the sequence column on the powers-of-attorney
  /// report.
  ///
  /// **TEXT, NOT A NUMBER.** Despite the name, the values are Latin letters —
  /// A, B, C. Typing it as an integer would fail the load on every row.
  serialNo             String? @map("serial_no")
  /// Access `اسم الموكل`, 100% — the name of the principal granting the power.
  principalName        String? @map("principal_name")
  /// Access `الصفة`, 100% — **the live capacity field.** The capacity in
  /// which the principal granted the power: `شخصي`, or a corporate office
  /// such as `عضو منتدب لشركة أكيومن`. Free text, 306 distinct values.
  poaCapacity          String? @map("poa_capacity")
  /// Access `صفة الموكل بالتوكيل`, 77% — **the abandoned duplicate of
  /// poa_capacity.** Migrated because nothing is deleted (D10). **Never read
  /// it**; every value it holds is either identical to poa_capacity, absent,
  /// or stale.
  poaCapacityDuplicate String? @map("poa_capacity_duplicate")

  /// Access `رقم التوكيل`, 99% — the number part of the POA reference.
  poaNumber String? @map("poa_number")
  /// Access `حرف`, 99% — the LETTER-SERIES part of the POA reference. 28
  /// values, nearly all single Arabic letters: `أ` on 183, `ب` on 167.
  /// The powers-of-attorney report prints the three parts together:
  /// **982 / أ / 2009** is number / letter / year.
  poaLetter String? @map("poa_letter")
  /// Access `السنة`, 99% — the year part of the same reference.
  poaYear   String? @map("poa_year")

  /// Access `جهة الإصدار`, 100% — the authority that issued it.
  issuingAuthority String?   @map("issuing_authority")
  /// Access `تاريخ الإصدار`, 100%.
  issueDate        DateTime? @map("issue_date") @db.Date

  /// Access `عدد النسخ`, 99% — **a LIVE COUNT of copies currently in the
  /// safe.** Not a static figure and not a yes/no flag.
  ///
  /// A lawyer takes a copy out to attend court and the count drops; it rises
  /// when the copy comes back. That is why the powers-of-attorney report
  /// highlights ZERO in yellow — "none available" — and why `ملاحظات` on
  /// those rows reads `عهدة إيهاب حمدي`. **Those rows are documents signed
  /// out, not errors.**
  ///
  /// Distribution in the original 735-row analysis: 0 on 113, 1 on 577, 2 on 29, 3 on 7,
  /// 4 on 2, 8 on one row, and 6 blank. So 39 rows (5%) hold more than one
  /// copy — normal practice, usually because the original was deposited at
  /// the Cassation court and certified copies were extracted
  /// (`تم إيداعة بالنقض وتم استخراج نسختين طبق الأصل`).
  ///
  /// **Plain integer, nullable, NO UPPER BOUND.** Never a boolean, and never
  /// a CHECK capping it at 1.
  /// **ZERO IS A VALID, MEANINGFUL STATE** — no copy available — and must
  /// never be treated as missing data or as an error.
  /// **The six blanks are genuinely unknown and stay NULL**, which is a
  /// different thing from zero.
  copiesCount Int? @map("copies_count")

  /// Access `ملاحظات`, 53%.
  notes           String?  @map("notes")
  /// Access `جرد`, 100% — confirmed by the firm's litigation assistant as the
  /// editable setting controlling inclusion on the POA list report. Current
  /// extraction: 697 shown and 55 hidden. It is not an inventory fact.
  showOnPoaReport Boolean? @map("show_on_poa_report")

  lawyers PowerOfAttorneyLawyer[]

  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor @relation("PowerOfAttorneyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "powers_of_attorney_created_by_fkey")
  updatedByActor AuditActor @relation("PowerOfAttorneyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "powers_of_attorney_updated_by_fkey")

  @@unique([legacySourceRecordKey], map: "powers_of_attorney_legacy_source_record_key_key")
  @@index([clientId])
  @@index([createdBy], map: "powers_of_attorney_created_by_idx")
  @@index([updatedBy], map: "powers_of_attorney_updated_by_idx")
  @@map("powers_of_attorney")
}

