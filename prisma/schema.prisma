/// Immutable chronological evidence introduced by Task 3.3B. Application
/// principals cannot read or write this table directly; row triggers and the
/// reviewed semantic gateway are its only runtime append paths.
model AuditEvent {
  id                         BigInt                 @id @default(autoincrement())
  eventVersion               Int                    @default(1) @map("event_version") @db.SmallInt
  occurredAt                 DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId                    Int                    @map("actor_id")
  actor                      AuditActor             @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_events_actor_fkey")
  actorKeySnapshot           String                 @map("actor_key_snapshot")
  actorUsernameSnapshot      String?                @map("actor_username_snapshot")
  actorDisplayNameSnapshot   String                 @map("actor_display_name_snapshot")
  actorRoleSnapshot          String?                @map("actor_role_snapshot")
  targetActorId              Int?                   @map("target_actor_id")
  targetActor                AuditActor?            @relation("AuditEventTargetActor", fields: [targetActorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_events_target_actor_fkey")
  targetActorKeySnapshot     String?                @map("target_actor_key_snapshot")
  targetUsernameSnapshot     String?                @map("target_username_snapshot")
  targetDisplayNameSnapshot  String?                @map("target_display_name_snapshot")
  targetRoleSnapshot         String?                @map("target_role_snapshot")
  action                     String
  outcome                    String
  entitySchema               String?                @map("entity_schema")
  entityTable                String?                @map("entity_table")
  entityKey                  Json?                  @map("entity_key") @db.JsonB
  changedFields              String[]               @default([]) @map("changed_fields")
  beforeValues               Json                   @default("{}") @map("before_values") @db.JsonB
  afterValues                Json                   @default("{}") @map("after_values") @db.JsonB
  requestId                  String                 @map("request_id") @db.Uuid
  correlationId              String                 @map("correlation_id") @db.Uuid
  auditSessionId             String                 @map("audit_session_id") @db.Uuid
  ipAddress                  String?                @map("ip_address") @db.Inet
  userAgent                  String?                @map("user_agent") @db.VarChar(512)
  userAgentTruncated         Boolean                @default(false) @map("user_agent_truncated")
  deviceClass                String                 @map("device_class") @db.VarChar(32)
  attemptedUsername          String?                @map("attempted_username") @db.VarChar(64)
  attemptedUsernameTruncated Boolean                @default(false) @map("attempted_username_truncated")
  resourceIdentifier         String?                @map("resource_identifier") @db.VarChar(256)
  reasonCode                 String?                @map("reason_code") @db.VarChar(64)
  parameters                 Json                   @default("{}") @db.JsonB
  eventMetadata              Json                   @default("{}") @map("event_metadata") @db.JsonB
  firstForCheckpoints        AuditEventCheckpoint[] @relation("AuditCheckpointFirstEvent")
  throughForCheckpoints      AuditEventCheckpoint[] @relation("AuditCheckpointThroughEvent")

  @@index([entitySchema, entityTable, entityKey, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_entity_newest_idx")
  @@index([actorId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_actor_newest_idx")
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_time_newest_idx")
  @@index([action, outcome, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_action_outcome_newest_idx")
  @@index([requestId, occurredAt, id], map: "audit_events_request_idx")
  @@index([correlationId, occurredAt, id], map: "audit_events_correlation_idx")
  @@map("audit_events")
}

/// Explicit per-table classification for row versus relationship events.
model AuditEventTableRule {
  entitySchema String            @map("entity_schema")
  entityTable  String            @map("entity_table")
  entityKind   String            @map("entity_kind")
  keyFields    String[]          @map("key_fields")
  fields       AuditEventField[]

  @@id([entitySchema, entityTable], map: "audit_event_table_rules_pkey")
  @@map("audit_event_table_rules")
}

/// Explicit field allowlist. `redacted` fields record only that the field
/// changed; their value is never admitted to an event.
model AuditEventField {
  entitySchema         String              @map("entity_schema")
  entityTable          String              @map("entity_table")
  fieldName            String              @map("field_name")
  maxTextCharacters    Int                 @map("max_text_characters") @db.SmallInt
  captureMode          String              @default("value") @map("capture_mode")
  classificationReason String              @map("classification_reason")
  tableRule            AuditEventTableRule @relation(fields: [entitySchema, entityTable], references: [entitySchema, entityTable], onDelete: Restrict, onUpdate: Restrict, map: "audit_event_fields_table_fkey")

  @@id([entitySchema, entityTable, fieldName], map: "audit_event_fields_pkey")
  @@map("audit_event_fields")
}

/// Immutable deployment boundary for the first real event. Later permanent
/// checks recompute both digests without changing this checkpoint.
model AuditEventCheckpoint {
  checkpointKey   String     @id @map("checkpoint_key")
  migrationName   String     @map("migration_name")
  baselineProfile String     @map("baseline_profile")
  eventCount      BigInt     @map("event_count")
  firstEventId    BigInt     @map("first_event_id")
  firstEvent      AuditEvent @relation("AuditCheckpointFirstEvent", fields: [firstEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_event_checkpoints_event_first_fkey")
  throughEventId  BigInt     @map("through_event_id")
  throughEvent    AuditEvent @relation("AuditCheckpointThroughEvent", fields: [throughEventId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_event_checkpoints_event_through_fkey")
  eventDigest     String     @map("event_digest") @db.Char(64)
  allowlistDigest String     @map("allowlist_digest") @db.Char(64)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_event_checkpoints")
}

/// A username/password login linked one-to-one to a person. Auth.js uses the
/// Credentials provider and encrypted JWT sessions; passwords, lockout state
/// and the session invalidation version remain server-side here.
///
/// `role_code` is a checked string rather than a PostgreSQL enum (D8). The
/// complete permission matrix is Task 3.2; Task 3.1 stores only the approved
/// role assignment needed in the session.
model UserAccount {
  id                  Int       @id @default(autoincrement())
  personId            Int       @unique @map("person_id")
  person              Person    @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_accounts_person_id_fkey")
  /// Approved display spelling. Login uses username_normalized instead.
  username            String
  usernameNormalized  String    @unique @map("username_normalized")
  passwordHash        String?   @map("password_hash")
  roleCode            String    @map("role_code")
  isEnabled           Boolean   @default(true) @map("is_enabled")
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  sessionVersion      Int       @default(0) @map("session_version")
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int         @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int?        @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor  @relation("UserAccountCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_accounts_created_by_fkey")
  updatedByActor AuditActor? @relation("UserAccountUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "user_accounts_updated_by_fkey")
  auditActor     AuditActor? @relation("AuditActorUserAccount")

  @@index([createdBy], map: "user_accounts_created_by_idx")
  @@index([updatedBy], map: "user_accounts_updated_by_idx")
  @@map("user_accounts")
}

/// Owner-reviewed, legacy-only English person names used by the Task 2.10A
/// billing migration. This is deliberately separate from application aliases:
/// application-native rows do not inherit a historical correction by accident.
model MigrationBillingPersonCrosswalk {
  sourceValue  String   @id @map("source_value")
  personId     Int      @map("person_id")
  person       Person   @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "migration_billing_person_crosswalk_person_fkey")
  legacyOnly   Boolean  @default(true) @map("legacy_only")
  reviewedBy   String   @map("reviewed_by")
  reviewedAt   DateTime @map("reviewed_at") @db.Date
  reviewerNote String   @map("reviewer_note")

  @@map("migration_billing_person_crosswalk")
}

/// Exact owner-reviewed billing currency interpretations. These are named
/// source values, never a generic trim or case-fold.
model MigrationBillingCurrencyRule {
  fieldKind         String   @map("field_kind")
  sourceValue       String   @map("source_value")
  targetValue       String?  @map("target_value")
  requireZeroAmount Boolean  @default(false) @map("require_zero_amount")
  reviewedBy        String   @map("reviewed_by")
  reviewedAt        DateTime @map("reviewed_at") @db.Date
  reviewerNote      String   @map("reviewer_note")

  @@id([fieldKind, sourceValue], map: "migration_billing_currency_rule_pkey")
  @@map("migration_billing_currency_rule")
}

/// Work teams. The label lives on the PERSON, never on the matter (D6): 87%
/// of matters were all on "team 1", so the field carried no information.
///
/// Two teams. Access "team 3" overlapped teams 1 and 2, was used by 3 matters
/// and had a different reviewer — an abandoned duplicate, deliberately not
/// created.
model LookupTeam {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  code        String?
  labelAr     String  @unique @map("label_ar")
  /// التخصصات, free text.
  specialisms String?
  /// المراجع — the partner who reviews this team's work.
  reviewerId  Int?    @map("reviewer_id")
  reviewer    Person? @relation("TeamReviewer", fields: [reviewerId], references: [id])
  sortOrder   Int     @default(100) @map("sort_order") @db.SmallInt
  isActive    Boolean @default(true) @map("is_active")

  members Person[] @relation("TeamMembers")

  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor @relation("LookupTeamCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_team_created_by_fkey")
  updatedByActor AuditActor @relation("LookupTeamUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_team_updated_by_fkey")

  @@index([createdBy], map: "lookup_team_created_by_idx")
  @@index([updatedBy], map: "lookup_team_updated_by_idx")
  @@map("lookup_team")
}

// ---------------------------------------------------------------------------
//  LOADED at Stage 2, task 2.7 — the multi-person split rules
//
//  migration_multi_person_rule (33), _member (84) and migration_excluded_name
//  (38) were created with task 2.7, on the same reasoning
//  as migration_crosswalk: they hold reviewed data now, so a note saying
//  "add them later" is a dependency on memory.
//
//  They were not created with the original roster because building the
//  assertion found that the then-current 66 member rows were not ready:
//
//    محمد عبدالعزيز عبد الحافظ   (2 rows)  the roster spells it
//                                          محمد عبد العزيز عبد الحافظ
//    عبدالرحمن البنا             (1 row)   the roster spells it
//                                          عبد الرحمن البنا
//    an entire eight-lawyer string pasted in as ONE member name (1 row) —
//    that rule was never split, so the matter using it would lose all eight
//
//  Task 1.2a added the reviewed spacing aliases. At task 2.7 the firm supplied
//  the missing 6 + 5 members and split the malformed pseudo-member into 8,
//  producing 84 valid ordered members. They now live in the Prisma models
//  above and are checked permanently by db:check.
// ---------------------------------------------------------------------------

// ===========================================================================
//  COURTS — task 1.3
//
//  A tenth lookup list, added here rather than at 1.1 because nothing needed
//  it until matters and hearings arrived.
//
//  A LIST, not free text. The firm counted: 305 distinct court names across
//  13,205 hearings, repeating heavily — القاهرة الاقتصادية 1,982 times,
//  شبين الكوم 1,192, شمال القاهرة 1,134. Egypt has a finite number of courts,
//  and docs/PERMISSIONS.md already promises the Administrator manages the
//  court dropdown.
//
//  EMPTY UNTIL STAGE 2. The values come from the Access data, and about 300
//  of them will need the same spelling-variant cleanup as every other Arabic
//  list — القضاء الإداري and القضاء الإداري بالعباسية may be one court with a
//  location suffix. That is a task 2.5 job, and every table that references a
//  court keeps its original text in a legacy_court_raw column so the cleanup
//  stays reversible.
//
//  THE CIRCUIT (الدائرة) IS DELIBERATELY NOT A LIST — see the Matter model.
// ===========================================================================

/// Courts. Administrator-managed. Filled at Stage 2, ~305 values before the
/// spelling cleanup.
model LookupCourt {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int         @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int         @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor  @relation("LookupCourtCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_court_created_by_fkey")
  updatedByActor AuditActor  @relation("LookupCourtUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_court_updated_by_fkey")
  matters        Matter[]
  hearings       Hearing[]
  adminTasks     AdminTask[]

  @@index([createdBy], map: "lookup_court_created_by_idx")
  @@index([updatedBy], map: "lookup_court_updated_by_idx")
  @@map("lookup_court")
}

// ===========================================================================
//  CORE TABLES — task 1.3
//
//  Nine tables from docs/DATA-MODEL.md, plus client_logos (a child of clients
//  that task 2.11 needs) and lookup_court above.
//
//  ALL EMPTY. Stage 2 fills them. They are built now, with correct keys, so
//  that adding the data later is a load and not a schema migration — the same
//  reasoning D3 gives for the billing tables.
//
//  TWO CONVENTIONS THAT APPLY TO EVERY TABLE BELOW
//
//  1. legacy_id — the Access primary key, kept for good.
//     Gate 4 has to reconcile row for row against Access, not merely count
//     (docs/MIGRATION.md), and a re-run of a transform has to be able to find
//     the row it wrote last time. Unique WHERE PRESENT: PostgreSQL allows many
//     NULLs in a unique column, so rows the firm creates in the new system
//     simply have none. The Access key names are ID_client, matterID,
//     ID_hearings, ID_Task and contractID — see scripts/01_extract_access.ps1.
//
//  2. _raw columns — the original text beside every many-to-one mapping.
//     D10 and the audit table in docs/MIGRATION.md. Four of the five that task
//     1.3 must create live here; the fifth, hearing_attendees.legacy_name_raw,
//     arrives with its table at task 1.4, and all five are asserted before
//     Stage 2 loads a row.
//     A COURT IS NOW ONE OF THEM: ~305 spellings collapsing to a cleaned list
//     is a many-to-one mapping, so every court_id has a legacy_court_raw
//     partner. Without it the Stage 2 cleanup would be irreversible.
//
//  NOTHING IS NOT-NULL THAT THE ACCESS DATA CANNOT GUARANTEE. A load must
//  never reject a row (docs/MIGRATION.md): 834 matters have no lawyer, 4
//  hearings have no matter, 1 power of attorney has no client, 14 matters will
//  lose their branch. Those all have to arrive and be dealt with visibly,
//  which a NOT NULL constraint would prevent.
// ===========================================================================

/// The firm and its clients. 313 rows at Stage 2.
model Client {
  id       Int  @id @default(autoincrement())
  /// Access ID_client. See the legacy_id convention above.
  legacyId Int? @unique @map("legacy_id")

  /// 100% filled in the Access data.
  nameAr             String  @map("name_ar")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  nameArNormalised   String? @map("name_ar_normalised")
  /// 73% filled. Kept for a possible future bilingual version (D12).
  nameEn             String? @map("name_en")
  fullName           String? @map("full_name")
  fullNameNormalised String? @map("full_name_normalised")

  branchId        Int?                @map("branch_id") @db.SmallInt
  branch          LookupClientBranch? @relation(fields: [branchId], references: [id])
  /// The original clientBranch text, byte for byte. NOT OPTIONAL as a design
  /// choice: the 32 original values resolve to 15 (D19) — 9 move to
  /// matter_category, 1 to matter_type, 1 to degree, 4 are quarantined and 2
  /// are discarded. Without this column that resolution could never be
  /// reversed or re-derived.
  legacyBranchRaw String?             @map("legacy_branch_raw")

  /// `العملاء.contactLawyer` — the FIRM lawyer responsible for this client,
  /// on 123 of 318. Byte for byte, never parsed.
  ///
  /// DECLARED HERE, NOT ONLY IN RAW SQL. Migration 0027 added it with an
  /// ALTER TABLE and did not touch this file, so the next `prisma migrate
  /// dev` computed a diff against a model that had never heard of it and
  /// offered to DROP IT — with all 123 values in it. It refused only because
  /// this session is non-interactive; in an interactive one somebody would
  /// have been asked, at the end of a long command, whether to drop a column.
  ///
  /// That is the same fault the trigram indexes had, recorded further down
  /// this file: Prisma removes what it can see the columns of but does not
  /// know about. Anything added in raw SQL to a table Prisma manages has to
  /// appear here too.
  legacyContactLawyerRaw String? @map("legacy_contact_lawyer_raw")

  cashOrProbono     String?   @map("cash_or_probono")
  status            String?
  poaLocation       String?   @map("poa_location")
  documentsLocation String?   @map("documents_location")
  clientStart       DateTime? @map("client_start") @db.Date
  clientEnd         DateTime? @map("client_end") @db.Date

  /// The main person to contact. Nullable, and deliberately a plain optional
  /// relation rather than a required one: clients and contacts point at each
  /// other, so one side has to be able to arrive first.
  contactPersonId Int?     @map("contact_person_id")
  contactPerson   Contact? @relation("ClientPrimaryContact", fields: [contactPersonId], references: [id])

  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int                         @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int                         @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor                  @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clients_created_by_fkey")
  updatedByActor AuditActor                  @relation("ClientUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clients_updated_by_fkey")
  contacts       Contact[]                   @relation("ClientContacts")
  logo           ClientLogo?
  logoImports    MigrationClientLogoImport[]
  matters        Matter[]
  poas           PowerOfAttorney[]
  documents      Document[]
  feeLetters     FeeLetter[]

  @@index([nameAr])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([nameArNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  /// full_name is searchable too, so it is indexed on the same footing as
  /// name_ar. 313 rows would not need one; the asymmetry would need
  /// explaining every time somebody read the model, which costs more than
  /// the index does.
  @@index([fullNameNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([createdBy], map: "clients_created_by_idx")
  @@index([updatedBy], map: "clients_updated_by_idx")
  @@map("clients")
}

/// Where a client logo file lives. 54 rows at Stage 2.
///
/// D15: the image is a FILE ON THE SERVER, never in the database and never in
/// cloud storage — /var/lib/litigation/client-logos/{client_id}/{filename}
///
/// One logo per client, so client_id is unique. A missing file must print the
/// client name in text and never break a report (D15).
model ClientLogo {
  id       Int    @id @default(autoincrement())
  clientId Int    @unique @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Relative to the logo root, never an absolute path — the root differs
  /// between the laptop and the Ubuntu server.
  relativePath String @map("relative_path")
  fileName     String @map("file_name")
  contentType  String @map("content_type")
  byteSize     Int    @map("byte_size")
  /// Checksum of the file as extracted from Access. Task 2.11 verifies it
  /// before and after writing, Gate 4 compares all 54, and it is what lets
  /// the weekly integrity job required by D15 report a CHANGED file rather
  /// than only a missing one.
  sha256       String

  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor @relation("ClientLogoCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "client_logos_created_by_fkey")
  updatedByActor AuditActor @relation("ClientLogoUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "client_logos_updated_by_fkey")

  @@index([createdBy], map: "client_logos_created_by_idx")
  @@index([updatedBy], map: "client_logos_updated_by_idx")
  @@map("client_logos")
}

/// Immutable historical evidence for the 54 Access logos imported at Task
/// 2.11. This is deliberately separate from ClientLogo: Task 4.1a may replace
/// a client's current logo, but that must not rewrite what the migration read,
/// where it wrote it or which client it resolved.
model MigrationClientLogoImport {
  sourceParentKey         Int      @id @map("source_parent_key")
  clientId                Int      @unique @map("client_id")
  client                  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientLogoId            Int      @unique @map("client_logo_id")
  sourceRecordKey         String   @unique @map("source_record_key")
  sourceExtractionSha256  String   @map("source_extraction_sha256")
  sourceStoredPath        String   @unique @map("source_stored_path")
  sourceFileName          String   @map("source_file_name")
  detectedContentType     String   @map("detected_content_type")
  byteSize                Int      @map("byte_size")
  sha256                  String
  destinationRelativePath String   @unique @map("destination_relative_path")
  complexCsvSha256        String   @map("complex_csv_sha256")
  importedAt              DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@map("migration_client_logo_import")
}

/// People to contact at a client. 188 rows at Stage 2.
///
/// Complete: all 17 Access columns are accounted for. The percentage on each
/// column is HOW MUCH OF IT IS ACTUALLY FILLED in the live data, supplied by
/// the firm. It is recorded because a fill rate is a design fact: Home Phone
/// has ONE row in 188, and a screen or report built around it would be blank
/// almost always.
///
/// **Contact1 is the real name field at 97%; Full_name is 10%.** Do not
/// assume from the names which one is primary — the firm checked.
///
/// Contacts.Attachments looks 100% populated and holds ZERO files. It is an
/// Access complex column (D11) and is NOT migrated.
model Contact {
  id       Int  @id @default(autoincrement())
  legacyId Int? @unique @map("legacy_id")

  /// Nullable: a contact whose client cannot be resolved loads with a null
  /// link and is queued for review, never dropped.
  clientId Int?    @map("client_id")
  client   Client? @relation("ClientContacts", fields: [clientId], references: [id])

  /// Access `Contact1`, 97% filled. THE name field, despite the column name.
  contactName           String? @map("contact_name")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  contactNameNormalised String? @map("contact_name_normalised")
  /// Access `Full_name`, 10% filled. Not the primary name — see above.
  fullName              String? @map("full_name")
  /// Access `Job Title`, 60%.
  jobTitle              String? @map("job_title")

  /// Access `E-mail Address`, 75%.
  email         String? @map("email")
  /// Access `Mobile Phone`, 73%.
  mobilePhone   String? @map("mobile_phone")
  /// Access `Business Phone`, 47%.
  businessPhone String? @map("business_phone")
  /// Access `Home Phone`, **1% — one row in 188.** Migrated, never surfaced.
  homePhone     String? @map("home_phone")
  /// Access `Fax Number`, 25%.
  faxNumber     String? @map("fax_number")
  /// Access `Web Page`, 14%.
  webPage       String? @map("web_page")

  /// Access `Address`, 67%.
  address       String? @map("address")
  /// Access `City`, 68%.
  city          String? @map("city")
  /// Access `State/Province`, 65%.
  stateProvince String? @map("state_province")
  /// Access `ZIP/Postal Code`, 6%.
  zipPostalCode String? @map("zip_postal_code")
  /// Access `Country/Region`, 65%.
  countryRegion String? @map("country_region")

  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor @relation("ContactCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contacts_created_by_fkey")
  updatedByActor AuditActor @relation("ContactUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contacts_updated_by_fkey")
  /// The clients for whom this person is the main contact.
  primaryFor     Client[]   @relation("ClientPrimaryContact")

  @@index([clientId])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([contactNameNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([createdBy], map: "contacts_created_by_idx")
  @@index([updatedBy], map: "contacts_updated_by_idx")
  @@map("contacts")
}

/// Matters — the central table. Task 2.6: 1,689 transformed + 55 quarantined
/// from 1,744 staged source rows.
///
/// The extracted Access source has 38 columns mixing identity, court logistics, money,
/// classification and free text. Only what the Dashboard actually reaches is
/// built (D1), and the classification is split into four independent lists
/// (D8) instead of the two overloaded ones Access had.
model Matter {
  id       Int  @id @default(autoincrement())
  /// Access matterID.
  legacyId Int? @unique @map("legacy_id")

  /// Durable identity of the complete staged source row. The Access id above
  /// is the business key; this hash proves which exact source values produced
  /// the migrated row and is independent of CSV filename and row order.
  legacySourceRecordKey        String? @unique @map("legacy_source_record_key")
  legacySourceExtractionSha256 String? @map("legacy_source_extraction_sha256")
  /// Complete 38-column source row for lossless migration audit. This does not
  /// reintroduce D6's team concept or perform task 2.7's lawyer/party split.
  legacySourcePayload          Json?   @map("legacy_source_payload") @db.JsonB

  /// **MULTI-LINE. NEVER SPLIT, NEVER COLLAPSED TO ONE LINE — D9.**
  /// 308 matters (18%) hold several case numbers stacked with line breaks:
  /// the journey of the matter up through the courts. The firm decided not to
  /// parse them; every screen and every report must render all the lines.
  caseNumberAr           String? @map("case_number_ar")
  /// Kept in step by a database TRIGGER, never written by the application —
  /// see migration 0016. A generated column cannot be used because Prisma
  /// would include it in every INSERT and PostgreSQL refuses that.
  caseNumberArNormalised String? @map("case_number_ar_normalised")
  /// Access matterEN, retained for the possible future bilingual version.
  caseNumberEn           String? @map("case_number_en")
  /// 98% filled.
  subject                String?
  subjectNormalised      String? @map("subject_normalised")

  clientId Int?    @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  /// D19: the source branch is a property of the matter, because one client
  /// can have several sites. Removed non-branch values leave this null.
  branchId        Int?                @map("branch_id") @db.SmallInt
  branch          LookupClientBranch? @relation(fields: [branchId], references: [id])
  /// Byte-exact Access clientBranch, including discarded and quarantined text.
  legacyBranchRaw String?             @map("legacy_branch_raw")

  // ---- classification: four independent lists, D8 ------------------------
  matterTypeId     Int?                     @map("matter_type_id") @db.SmallInt
  matterType       LookupMatterType?        @relation(fields: [matterTypeId], references: [id])
  matterCategoryId Int?                     @map("matter_category_id") @db.SmallInt
  matterCategory   LookupMatterCategory?    @relation(fields: [matterCategoryId], references: [id])
  degreeId         Int?                     @map("degree_id") @db.SmallInt
  degree           LookupDegree?            @relation(fields: [degreeId], references: [id])
  venueId          Int?                     @map("venue_id") @db.SmallInt
  venue            LookupVenue?             @relation(fields: [venueId], references: [id])
  importanceId     Int?                     @map("importance_id") @db.SmallInt
  importance       LookupImportance?        @relation(fields: [importanceId], references: [id])
  destinationId    Int?                     @map("destination_id") @db.SmallInt
  destination      LookupMatterDestination? @relation(fields: [destinationId], references: [id])

  /// The original matterCategory and matterDegree text, byte for byte. 50 and
  /// 40 values collapse into the four lists above; without these the split
  /// could not be re-derived or corrected (D10).
  legacyCategoryRaw String? @map("legacy_category_raw")
  legacyDegreeRaw   String? @map("legacy_degree_raw")

  /// Source extraction: سارية 507 / منتهية 1,223 / null 14.
  status String?

  /// Access fields whose names do not establish a safer semantic model. They
  /// are migrated, retained, and not surfaced until a screen/report needs them.
  notes1                       String?   @map("notes_1")
  notes2                       String?   @map("notes_2")
  startDate                    DateTime? @map("start_date") @db.Date
  endDate                      DateTime? @map("end_date") @db.Date
  askedAmount                  Decimal?  @map("asked_amount") @db.Decimal(18, 2)
  judgedAmount                 Decimal?  @map("judged_amount") @db.Decimal(18, 2)
  legacySelected               Boolean?  @map("legacy_selected")
  evaluation                   String?
  currentStatus                String?   @map("current_status")
  legacyClientTypeRaw          String?   @map("legacy_client_type_raw")
  legacyFinancialAllocationRaw String?   @map("legacy_financial_allocation_raw")
  legalOpinion                 String?   @map("legal_opinion")
  legacyContractIdRaw          String?   @map("legacy_contract_id_raw")
  /// Preserved for task 2.7. It is never matched directly to a person name.
  legacyPartnerRaw             String?   @map("legacy_partner_raw")

  // ---- where it is heard -------------------------------------------------
  /// court and circuit are TWO SEPARATE FIELDS, not one. Reports join them
  /// for display — الإدارية العليا (11 موضوع),
  /// المحكمة الاقتصادية (الدائرة: (9) استئناف) — but they are stored apart.
  /// Source: docs/REPORT-LAYOUTS.md, "Type 4 — Client status report".
  courtId        Int?         @map("court_id") @db.SmallInt
  court          LookupCourt? @relation(fields: [courtId], references: [id])
  legacyCourtRaw String?      @map("legacy_court_raw")

  /// **TEXT, DELIBERATELY NOT A LIST.** 1,281 distinct values in the hearings
  /// table alone. They are two facts in one field — a circuit number and a
  /// specialism (1 عمال, 12 عمال, 8 تجاري, 7 استئناف, 4 أفراد) — varying by
  /// court. A 1,281-option dropdown is unusable and a list would fight the
  /// data. Whether to split it into number + specialism is a question for
  /// AFTER the data lands: see task 2.6. Do not attempt the split now.
  circuit          String?
  circuitSecretary String? @map("circuit_secretary")

  // ---- court logistics ---------------------------------------------------
  /// Kept on the matter rather than in a matter_court_details table. Four
  /// columns on one row per matter; a separate table buys nothing until
  /// something needs many of them per matter, and it would add a join to
  /// every matter screen. Settled 22 August 2026 — the open question in
  /// docs/DATA-MODEL.md is closed.
  courtFloor         String? @map("court_floor")
  courtHall          String? @map("court_hall")
  courtShelf         String? @map("court_shelf")
  courtSecretaryRoom String? @map("court_secretary_room")

  /// الدعاوى.[خطاب الأتعاب] — text in two key spaces, not a foreign key.
  /// 412 matters carry a reference: 289 resolve through contractID and 123
  /// through mfilesID; none resolve through both and none through neither.
  /// Task 2.9D applied the firm's reviewed explicit rule and preserved this
  /// original text. This is separate from fee_letter_matters (288 values
  /// across 195 parents), and the two counts must not be reconciled together.
  feeLetterRef String? @map("fee_letter_ref")

  /// Task 2.9D's resolved reverse reference. Kept separate from
  /// fee_letter_matters because the two Access relationships have different
  /// source columns and different cardinalities.
  feeLetterReferenceLink MatterFeeLetterReference?

  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor        @relation("MatterCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "matters_created_by_fkey")
  updatedByActor AuditActor        @relation("MatterUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "matters_updated_by_fkey")
  hearings       Hearing[]
  adminTasks     AdminTask[]
  documents      Document[]
  lawyers        MatterLawyer[]
  parties        MatterParty[]
  feeLetters     FeeLetterMatter[]

  @@index([clientId])
  @@index([branchId])
  @@index([status])
  @@index([courtId])
  /// The trigram index that makes a LIKE '%…%' search fast. DECLARED HERE ON
  /// PURPOSE: when it lived only in raw SQL, the next `prisma migrate dev`
  /// dropped it — Prisma removes an index it can see the columns of but does
  /// not know about. db:check caught that; this stops it recurring.
  @@index([caseNumberArNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([subjectNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([createdBy], map: "matters_created_by_idx")
  @@index([updatedBy], map: "matters_updated_by_idx")
  @@map("matters")
}

/// Hearings and their decisions. 13,382 source rows at task 2.8 — the largest
/// table; 13,055 transformed and 327 retained in durable quarantine.
///
/// Every list screen and report over this table needs paging and indexed
/// filters (task 4.3). The indexes at the foot are the ones the traced screens
/// and reports actually use: by matter, by date, and the "today's hearings"
/// panel on the dashboard, which reads the next date.
model Hearing {
  id       Int  @id @default(autoincrement())
  /// Access ID_hearings.
  legacyId Int? @unique @map("legacy_id")

  /// Nullable: 4 hearings in the Access data have no matter. They load into an
  /// unassigned bucket rather than being rejected (docs/MIGRATION.md).
  matterId Int?    @map("matter_id")
  matter   Matter? @relation(fields: [matterId], references: [id])

  hearingDate     DateTime? @map("hearing_date") @db.Date
  nextHearingDate DateTime? @map("next_hearing_date") @db.Date

  /// Access تقرير: a stored boolean flag, preserved even though its business
  /// use has not yet been surfaced in the web application.
  report            Boolean?
  /// Access lastDecision, retained verbatim.
  previousDecision  String?  @map("previous_decision")
  /// Access حضور الجلسة القادمة. This is raw text, not a boolean and not the
  /// same field as client_notified.
  nextAttendanceRaw String?  @map("next_attendance_raw")

  actionId        Int?                 @map("action_id") @db.SmallInt
  action          LookupHearingAction? @relation(fields: [actionId], references: [id])
  /// The original الإجراء text. 23 actions merged to 20 on 21 August 2026
  /// (محكمه and مجكمة into محكمة, رفع الدعوي into رفع الدعوى), which affects
  /// 18 hearings and makes the mapping many-to-one. Without this the merge
  /// could never be reversed.
  legacyActionRaw String?              @map("legacy_action_raw")

  decision String?
  /// صالح / ضد. Drives the for-and-against reports and the dashboard charts.
  outcome  String?

  courtId              Int?                     @map("court_id") @db.SmallInt
  court                LookupCourt?             @relation(fields: [courtId], references: [id])
  legacyCourtRaw       String?                  @map("legacy_court_raw")
  /// Set only by a firm-reviewed court rule saying the source value is a
  /// destination rather than a court. The independent Access الجهة text is
  /// preserved separately and is never overwritten by that rule.
  destinationId        Int?                     @map("destination_id") @db.SmallInt
  destination          LookupMatterDestination? @relation(fields: [destinationId], references: [id])
  legacyDestinationRaw String?                  @map("legacy_destination_raw")
  /// Text, for the same reason as Matter.circuit.
  circuit              String?
  legacyCircuitRaw     String?                  @map("legacy_circuit_raw")

  /// A reviewed court split may supply a hearing note. The exact source note
  /// remains beside it so the derivation is reversible.
  notes          String?
  legacyNotesRaw String? @map("legacy_notes_raw")
  shortDecision  String? @map("short_decision")

  clientNotified Boolean? @map("client_notified")

  /// Durable complete-row identity. Filename and row number are trace only.
  legacySourceRecordKey        String? @unique @map("legacy_source_record_key")
  legacySourceExtractionSha256 String? @map("legacy_source_extraction_sha256")
  /// All 21 source columns, preserving NULL, empty text, Arabic and line breaks.
  legacySourcePayload          Json?   @map("legacy_source_payload")

  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor        @relation("HearingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "hearings_created_by_fkey")
  updatedByActor AuditActor        @relation("HearingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "hearings_updated_by_fkey")
  attendees      HearingAttendee[]

  @@index([matterId])
  @@index([hearingDate])
  @@index([nextHearingDate])
  @@index([courtId])
  @@index([destinationId])
  @@index([createdBy], map: "hearings_created_by_idx")
