/// A party's legal capacity. 11 roles (decision D7), replacing 242 distinct
/// capacity strings that were mostly grammatical inflections of these.
///
/// Masculine and feminine forms are stored so the right word can be rendered
/// from the role plus the party's gender. طاعن and متظلم are DIFFERENT roles
/// and must never be merged.
model LookupPartyRole {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  code      String  @unique
  labelArM  String  @map("label_ar_m")
  labelArF  String  @map("label_ar_f")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int               @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor        @relation("LookupPartyRoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_party_role_created_by_fkey")
  updatedByActor AuditActor        @relation("LookupPartyRoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_party_role_updated_by_fkey")
  partyRoles     MatterPartyRole[]

  @@index([createdBy], map: "lookup_party_role_created_by_idx")
  @@index([updatedBy], map: "lookup_party_role_updated_by_idx")
  @@map("lookup_party_role")
}

/// What happened at a hearing (الإجراء)? 20 values, sorted by how often each
/// appears in the live data.
///
/// Was 23. Three were keyboard slips of other values in the same list, merged
/// on 21 August 2026 after the firm re-analysed them:
///
///   محكمه       ه for ة                      -> محكمة
///   مجكمة       ج for ح, adjacent keys       -> محكمة
///   رفع الدعوي  ي for ى                      -> رفع الدعوى
///
/// Scale: محكمة is on 11,210 hearings, its two misspellings on 17 between
/// them. Typos, not distinctions.
///
/// تحكيم (arbitration) and تحقيق (investigation) are NOT merged. They look
/// similar to an algorithm and are different words.
///
/// Nothing is lost by merging: every hearing keeps its original text in
/// hearings.legacy_action_raw, so a merge can be reversed.
model LookupHearingAction {
  id        Int     @id @default(autoincrement()) @db.SmallInt
  labelAr   String  @unique @map("label_ar")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(100) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("created_by")
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      Int        @default(dbgenerated("audit_current_actor_id()")) @map("updated_by")
  createdByActor AuditActor @relation("LookupHearingActionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_hearing_action_created_by_fkey")
  updatedByActor AuditActor @relation("LookupHearingActionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lookup_hearing_action_updated_by_fkey")
  hearings       Hearing[]

  @@index([createdBy], map: "lookup_hearing_action_created_by_idx")
  @@index([updatedBy], map: "lookup_hearing_action_updated_by_idx")
  @@map("lookup_hearing_action")
}

