  "functions": [
    {
      "proname": "task69_allowlist_bound",
      "arguments": "",
      "result": "trigger",
      "prosrc": "\nDECLARE expected text;\nBEGIN\n SELECT contract_text::jsonb->'entries'->>NEW.issue_id INTO expected FROM _migration.task69_operation WHERE operation_id=NEW.operation_id;\n IF expected IS DISTINCT FROM NEW.entry_sha256 THEN RAISE EXCEPTION 'Task69 issue differs from sealed operation allowlist'; END IF;\n RETURN NEW;\nEND ",
      "prosecdef": true,
      "proconfig": ["search_path=pg_catalog, public"],
      "provolatile": "v",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    },
    {
      "proname": "task69_authorize_issue",
      "arguments": "p_operation uuid, p_issue text, p_payload_hash text, p_account integer, p_version integer, p_role text, p_expires timestamp with time zone, p_session uuid",
      "result": "jsonb",
      "prosrc": "\nDECLARE actor integer; operation _migration.task69_operation%ROWTYPE; receipt _migration.task69_receipt%ROWTYPE; delta _migration.task69_delta%ROWTYPE; current_row jsonb;\nBEGIN\n -- Always before receipt reuse: a formerly authorized person is not enough.\n actor:=_migration.task69_require_actor(p_account,p_version,p_role,p_expires,p_session);\n SELECT * INTO operation FROM _migration.task69_operation WHERE operation_id=p_operation FOR SHARE;\n IF NOT FOUND OR operation.target_cluster IS DISTINCT FROM (pg_control_system()).system_identifier::text\n OR operation.target_database IS DISTINCT FROM current_database() THEN RAISE EXCEPTION 'Task69 operation target differs'; END IF;\n PERFORM 1 FROM _migration.task69_allowlist WHERE operation_id=p_operation AND issue_id=p_issue AND payload_sha256=p_payload_hash FOR SHARE;\n IF NOT FOUND THEN RAISE EXCEPTION 'Task69 issue or approved payload differs'; END IF;\n IF EXISTS(SELECT 1 FROM _migration.task69_receipt WHERE operation_id=p_operation AND issue_id=p_issue AND phase='compensate') THEN RAISE EXCEPTION 'Task69 compensated issue requires a separately reviewed operation'; END IF;\n SELECT * INTO receipt FROM _migration.task69_receipt WHERE operation_id=p_operation AND issue_id=p_issue AND phase='apply';\n IF NOT FOUND THEN RETURN jsonb_build_object('actorId',actor,'receipt',NULL); END IF;\n IF NOT _migration.task69_receipt_valid(receipt.receipt_id) THEN RAISE EXCEPTION 'Task69 prior receipt is incomplete'; END IF;\n FOR delta IN SELECT * FROM _migration.task69_delta WHERE receipt_id=receipt.receipt_id ORDER BY ordinal LOOP\n  EXECUTE format('SELECT to_jsonb(r) FROM %I.%I r WHERE id=$1 FOR SHARE',delta.entity_schema,delta.entity_table) INTO current_row USING (delta.entity_key->>'id')::integer;\n  IF current_row IS DISTINCT FROM delta.after_values THEN RAISE EXCEPTION 'Task69 receipt postimage was edited: %.% %',delta.entity_schema,delta.entity_table,delta.entity_key; END IF;\n END LOOP;\n RETURN jsonb_build_object('actorId',actor,'receipt',to_jsonb(receipt));\nEND ",
      "prosecdef": false,
      "proconfig": ["search_path=pg_catalog, public", "TimeZone=UTC"],
      "provolatile": "v",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    },
    {
      "proname": "task69_contract_valid",
      "arguments": "p_operation uuid",
      "result": "boolean",
      "prosrc": "\nDECLARE operation _migration.task69_operation%ROWTYPE; item record; expected jsonb; observed jsonb;\nBEGIN\n SELECT * INTO operation FROM _migration.task69_operation WHERE operation_id=p_operation;\n IF NOT FOUND THEN RETURN false; END IF;\n expected:=(operation.contract_text::jsonb)->'entries';\n SELECT coalesce(jsonb_object_agg(issue_id,entry_sha256),'{}') INTO observed FROM _migration.task69_allowlist WHERE operation_id=p_operation;\n IF observed IS DISTINCT FROM expected THEN RETURN false; END IF;\n IF (SELECT count(*) FROM _migration.task69_allowlist WHERE operation_id=p_operation AND unit_kind='issue')<>3465 THEN RETURN false; END IF;\n FOR item IN SELECT * FROM (VALUES ('S1-party-display',743),('S2-lawyer-membership',191),('S3-admin-parents',544),('S4-step-restoration',769),('S5-poa-membership',714),('S6-documents',291),('S7-fee-provenance',76),('S8-history-dispositions',137)) x(stage,expected_count) LOOP\n  IF (SELECT count(*) FROM _migration.task69_allowlist WHERE operation_id=p_operation AND stage=item.stage)<>item.expected_count THEN RETURN false; END IF;\n END LOOP;\n RETURN true;\nEND ",
      "prosecdef": true,
      "proconfig": ["search_path=pg_catalog, public"],
      "provolatile": "s",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    },
    {
      "proname": "task69_immutable",
      "arguments": "",
      "result": "trigger",
      "prosrc": "\nBEGIN RAISE EXCEPTION 'Task69 contract, source occurrences, deltas and receipts are immutable'; END ",
      "prosecdef": true,
      "proconfig": ["search_path=pg_catalog, public"],
      "provolatile": "v",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    },
    {
      "proname": "task69_receipt_valid",
      "arguments": "p_receipt uuid",
      "result": "boolean",
      "prosrc": "\nDECLARE receipt _migration.task69_receipt%ROWTYPE; delta _migration.task69_delta%ROWTYPE; event public.audit_events%ROWTYPE; expected_before jsonb; expected_after jsonb; expected_fields text[]; prior _migration.task69_receipt%ROWTYPE;\nBEGIN\n SELECT * INTO receipt FROM _migration.task69_receipt WHERE receipt_id=p_receipt;\n IF NOT FOUND OR (SELECT count(*) FROM _migration.task69_delta WHERE receipt_id=p_receipt)<>receipt.expected_delta_count\n OR (SELECT count(*) FROM public.audit_events WHERE request_id=receipt.request_id)<>receipt.expected_delta_count THEN RETURN false; END IF;\n IF NOT EXISTS(SELECT 1 FROM public.audit_events WHERE actor_id=receipt.actor_id AND audit_session_id=receipt.audit_session_id AND action='login_succeeded' AND outcome='succeeded') THEN RETURN false; END IF;\n IF receipt.phase='compensate' THEN\n  SELECT * INTO prior FROM _migration.task69_receipt WHERE receipt_id=receipt.prior_receipt_id;\n  IF NOT FOUND OR prior.phase<>'apply' OR prior.operation_id<>receipt.operation_id OR prior.issue_id<>receipt.issue_id OR prior.payload_sha256<>receipt.payload_sha256 THEN RETURN false; END IF;\n END IF;\n FOR delta IN SELECT * FROM _migration.task69_delta WHERE receipt_id=p_receipt LOOP\n  SELECT * INTO event FROM public.audit_events WHERE id=delta.audit_event_id;\n  IF NOT FOUND OR event.actor_id<>receipt.actor_id OR event.audit_session_id IS DISTINCT FROM receipt.audit_session_id\n  OR event.request_id IS DISTINCT FROM receipt.request_id OR event.correlation_id IS DISTINCT FROM receipt.operation_id\n  OR event.entity_schema<>delta.entity_schema OR event.entity_table<>delta.entity_table OR event.entity_key<>delta.entity_key\n  OR event.outcome IS DISTINCT FROM 'succeeded' OR (event.actor_role_snapshot IN('Administrator','Litigation Assistant')) IS NOT TRUE\n OR event.action IS DISTINCT FROM (SELECT CASE WHEN entity_kind='record' THEN CASE WHEN delta.before_values IS NULL THEN 'record_created' ELSE 'record_updated' END ELSE CASE WHEN delta.before_values IS NULL THEN 'relationship_added' ELSE 'relationship_updated' END END FROM public.audit_event_table_rules WHERE entity_schema=delta.entity_schema AND entity_table=delta.entity_table) THEN RETURN false; END IF;\n  SELECT array_agg(f.field_name ORDER BY f.field_name),\n   CASE WHEN delta.before_values IS NULL THEN '{}'::jsonb ELSE coalesce(jsonb_object_agg(f.field_name,public.audit_bound_json_value(delta.before_values->f.field_name,f.max_text_characters,f.capture_mode)),'{}') END,\n   coalesce(jsonb_object_agg(f.field_name,public.audit_bound_json_value(delta.after_values->f.field_name,f.max_text_characters,f.capture_mode)),'{}')\n   INTO expected_fields,expected_before,expected_after\n  FROM public.audit_event_fields f WHERE f.entity_schema=delta.entity_schema AND f.entity_table=delta.entity_table\n   AND f.capture_mode IN('value','redacted') AND (delta.before_values IS NULL OR delta.before_values->f.field_name IS DISTINCT FROM delta.after_values->f.field_name);\n  IF event.changed_fields IS DISTINCT FROM expected_fields OR event.before_values IS DISTINCT FROM expected_before OR event.after_values IS DISTINCT FROM expected_after THEN RETURN false; END IF;\n END LOOP;\n RETURN true;\nEND ",
      "prosecdef": true,
      "proconfig": ["search_path=pg_catalog, public"],
      "provolatile": "s",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    },
    {
      "proname": "task69_require_actor",
      "arguments": "p_account integer, p_version integer, p_role text, p_expires timestamp with time zone, p_session uuid",
      "result": "integer",
      "prosrc": "\nDECLARE actor integer;\nBEGIN\n IF current_user<>session_user OR NOT (SELECT rolsuper FROM pg_roles WHERE rolname=session_user) THEN\n  RAISE EXCEPTION USING ERRCODE='42501',MESSAGE='Task69 requires direct administration principal';\n END IF;\n IF p_session IS NULL OR p_expires IS NULL OR p_expires>clock_timestamp()+interval '31 days' THEN\n  RAISE EXCEPTION USING ERRCODE='42501',MESSAGE='Current genuine Task69 session required';\n END IF;\n actor:=_migration.matter_edit_require_account(p_account,p_version,p_role,p_expires,true);\n IF (SELECT count(*) FROM public.audit_events WHERE actor_id=actor AND audit_session_id=p_session\n  AND action='login_succeeded' AND outcome='succeeded')<>1\n OR EXISTS(SELECT 1 FROM public.audit_events WHERE actor_id=actor AND audit_session_id=p_session\n  AND action='logout' AND outcome='succeeded') THEN\n  RAISE EXCEPTION USING ERRCODE='42501',MESSAGE='Task69 session lacks one genuine current sign-in';\n END IF;\n RETURN actor;\nEND ",
      "prosecdef": false,
      "proconfig": ["search_path=pg_catalog, public"],
      "provolatile": "v",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    },
    {
      "proname": "task69_require_contract",
      "arguments": "",
      "result": "trigger",
      "prosrc": "\nBEGIN\n IF NEW.target_cluster IS DISTINCT FROM (pg_control_system()).system_identifier::text\n OR NEW.target_database IS DISTINCT FROM current_database()\n OR NOT _migration.task69_contract_valid(NEW.operation_id) THEN\n  RAISE EXCEPTION 'Task69 contract is incomplete or belongs to another database';\n END IF;\n RETURN NULL;\nEND ",
      "prosecdef": true,
      "proconfig": ["search_path=pg_catalog, public"],
      "provolatile": "v",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    },
    {
      "proname": "task69_require_receipt",
      "arguments": "",
      "result": "trigger",
      "prosrc": "\nDECLARE identity uuid;\nBEGIN\n identity:=NEW.receipt_id;\n IF NOT _migration.task69_receipt_valid(identity) THEN RAISE EXCEPTION 'Task69 receipt lacks exact atomic audit and delta correspondence'; END IF;\n RETURN NULL;\nEND ",
      "prosecdef": true,
      "proconfig": ["search_path=pg_catalog, public"],
      "provolatile": "v",
      "prokind": "f",
      "proisstrict": false,
      "proleakproof": false,
      "proparallel": "u",
      "owner": "litigation"
    }
  ]
