    {
      "conname": "task62_source_receipt_source_sha256_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (source_sha256 = '5b0ee4419e81b8f8f1c66834d0a24e2c023912acb1efd2617b58a435332b7dfd'::text)"
    },
    {
      "conname": "task62_source_receipt_source_values_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (jsonb_typeof(source_values) = 'object'::text)"
    },
    {
      "conname": "task62_source_receipt_target_id_check",
      "contype": "c",
      "convalidated": true,
