    },
    {
      "conname": "task62_source_receipt_after_values_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (jsonb_typeof(after_values) = 'object'::text)"
    },
    {
      "conname": "task62_source_receipt_approved_plan_text_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (encode(sha256(convert_to(approved_plan_text, 'UTF8'::name)), 'hex'::text) = 'c0b0590c693b139b57bb78a4a8d24640af2ee6ab73e4e0ee1f9aa89d12b1be6e'::text)"
    },
    {
