      "tgnargs": 0,
      "attributes": "",
      "definition": "CREATE CONSTRAINT TRIGGER task62_source_atomic_audit AFTER INSERT ON audit_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (new.request_id::text ~ '^62620075-[a-f0-9]{4}-5[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$'::text) EXECUTE FUNCTION _migration.task62_source_require_complete()"
