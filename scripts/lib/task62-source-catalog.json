    },
    {
      "conname": "task62_source_receipt_before_values_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (before_values = '{}'::jsonb)"
    },
    {
      "conname": "task62_source_receipt_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (kind = 'party_release'::text AND role_audit_event_id IS NOT NULL AND source_identity ~ '^quarantine:[1-9][0-9]*$'::text OR kind = 'hearing_source'::text AND role_audit_event_id IS NULL AND source_identity ~ '^hearing:[1-9][0-9]*$'::text)"
    },
    {
      "conname": "task62_source_receipt_kind_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (kind = ANY (ARRAY['party_release'::text, 'hearing_source'::text]))"
    },
    {
      "conname": "task62_source_receipt_kind_target_id_key",
      "contype": "u",
      "convalidated": true,
      "definition": "UNIQUE (kind, target_id)"
    },
    {
      "conname": "task62_source_receipt_matter_id_fkey",
      "contype": "f",
      "convalidated": true,
      "definition": "FOREIGN KEY (matter_id) REFERENCES matters(id)"
    },
    {
      "conname": "task62_source_receipt_operation_id_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (operation_id::text ~ '^62620075-[a-f0-9]{4}-5[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$'::text)"
    },
    {
