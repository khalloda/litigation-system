# ===========================================================================
#  Copy this file to `.env` and adjust. `.env` is never committed — it is in
#  .gitignore because it holds the database password.
#
#      cp .env.example .env
# ===========================================================================

# ---- Which machine is this? ----------------------------------------------
# development  = a laptop. npm run db:reset is allowed here.
# production   = the live server. npm run db:reset refuses outright, with no
#                override, because the database there holds the firm's real
#                case records.
#
# SET THIS TO production ON THE UBUNTU SERVER. The server's database also
# lives at localhost, so the "is it local?" check cannot tell the two apart.
# This line is what does.
APP_ENV=development

# ---- Database ------------------------------------------------------------
POSTGRES_DB=litigation
POSTGRES_USER=litigation

# CHANGE THIS ON THE SERVER. On the laptop it does not matter much: the
# database only listens on 127.0.0.1, so nothing outside this machine can
# reach it. On the Ubuntu server, set a long random password here.
POSTGRES_PASSWORD=dev_only_change_me

# 5433, not the usual 5432. The owner's laptop already has a PostgreSQL on
# 5432 belonging to the ZKBioTime attendance system, which must be left alone.
# On a clean Ubuntu server 5432 would be free, but keeping one number for both
# machines means one set of instructions.
POSTGRES_PORT=5433

# ---- Separate database principals (D33, D35 / Task 3.3A) -----------------
# Prisma migrations and controlled administration require a directly
# authenticated PostgreSQL superuser. The web application must use the
# separate restricted principal. This combined example is for local
# development only: in production inject MIGRATION_DATABASE_URL only into the
# controlled migration/admin shell, and omit it entirely from the web service
# environment. Replace both placeholders locally; never copy a development
# password to production.
MIGRATION_DATABASE_URL=postgresql://litigation:replace_migration_password@localhost:5433/litigation?schema=public
DATABASE_URL=postgresql://litigation_runtime:replace_runtime_password@localhost:5433/litigation?schema=public

# ---- Authentication ------------------------------------------------------
# Required before the web application starts. Set at least 32 random bytes
# from a password manager or operating-system cryptographic generator. Never
# commit, paste into a command argument, or share the real value.
AUTH_SECRET=

# Development address. Production uses the HTTPS address of the Ubuntu host.
AUTH_URL=http://localhost:3000

# Forwarded client addresses are audit evidence only when a trusted reverse
# proxy is configured to replace this header. Keep false for direct/local use;
# Next.js does not expose the directly observed peer address to Auth.js here.
AUDIT_TRUST_PROXY=false

# ---- Client logo files (D15) ---------------------------------------------
# Windows development example:
CLIENT_LOGO_ROOT=D:\Projects\litigation-system\storage\client-logos
# Production must instead use: /var/lib/litigation/client-logos
